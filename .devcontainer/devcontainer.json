{
  "name": "Cubic Anomaly / E6 Verification",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements-notebook.txt && lake exe cache get",
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.elan/bin:${containerEnv:PATH}"
  }
}
