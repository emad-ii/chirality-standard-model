{
  "name": "chirality-standard-model-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "check:assets": "node scripts/sync-assets.mjs --check",
    "predev": "npm run sync:assets",
    "prebuild": "npm run sync:assets",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "check:data": "node --experimental-strip-types scripts/check-data.ts",
    "check:physics": "node --experimental-strip-types scripts/check-physics.ts",
    "check:experience": "node --experimental-strip-types scripts/check-experience.ts",
    "check:foundations": "node --experimental-strip-types scripts/check-foundations.ts",
    "check:components": "vitest run",
    "check": "npm run check:assets && npm run check:data && npm run check:physics && npm run check:experience && npm run check:foundations && npm run check:components",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "d3": "7.9.0",
    "three": "0.185.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "jsdom": "27.4.0",
    "vitest": "4.1.11",
    "@types/d3": "7.4.3",
    "@types/three": "0.185.4",
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260903.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
