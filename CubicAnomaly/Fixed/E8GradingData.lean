import CubicAnomaly.Fixed.E8BracketData
import Mathlib.Data.ZMod.Basic

/-!
# Exact order-three grading data for the fixed exceptional algebra

The seventh simple-root coordinate modulo three grades the literal sparse
bracket. The bracket-support theorem is proved symbolically for every data
label. Finite certificates supply the dimensions and the orthogonal
72-plus-6 decomposition of the degree-zero roots.

These are data for an actual subalgebra and its two complementary modules;
no classification or representation identification is assumed.
-/

namespace CubicAnomaly.Fixed.E8GradingData

open CubicAnomaly.Fixed.E8BracketData
open scoped BigOperators

/-- Cartan coordinates have degree zero; root degree is coordinate six modulo three. -/
def grade : DataIndex → ZMod 3
  | .inl _ => 0
  | .inr v => (v[6] : ZMod 3)

/-- The sparse bracket respects degree even before restriction to the root table. -/
theorem e8_sparse_bracket_graded (x y : DataIndex) :
    ∀ p ∈ bracket x y, grade p.1 = grade x + grade y := by
  cases x with
  | inl i =>
    cases y with
    | inl j => simp [bracket]
    | inr v => simp [bracket, E8BracketData.singleton, grade]
  | inr v =>
    cases y with
    | inl j => simp [bracket, E8BracketData.singleton, grade]
    | inr w =>
      by_cases hneg : w = negateVector v
      · subst w
        simp only [bracket]
        intro p hp
        obtain ⟨i, _, rfl⟩ := List.mem_map.mp hp
        simp [grade, negateVector]
      · simp only [bracket, if_neg hneg]
        split_ifs with hroot
        · simp [E8BracketData.singleton, grade, addVector]
        · simp

/-- The finite labels of one homogeneous piece. -/
def gradeLabels (a : ZMod 3) : Finset DataIndex :=
  basisList.toFinset.filter fun d => grade d = a

theorem e8_mem_gradeLabels (a : ZMod 3) (d : DataIndex) :
    d ∈ gradeLabels a ↔ d ∈ basisList ∧ grade d = a := by
  simp [gradeLabels]

/-- The actual basis census, including all eight zero-weight coordinates. -/
theorem e8_grading_card_certificate :
    (gradeLabels 0).card = 86 ∧ (gradeLabels 1).card = 81 ∧
      (gradeLabels 2).card = 81 := by
  native_decide

/-- The roots of degree zero, before adding the eight Cartan coordinates. -/
def zeroRoots : Finset RootVector :=
  rootList.toFinset.filter fun v => grade (.inr v) = 0

/-- The roots supported on the first six simple coordinates. -/
def e6Roots : Finset RootVector :=
  rootList.toFinset.filter fun v => v[6] = 0 ∧ v[7] = 0

/-- The last simple root. -/
def a2First : RootVector := simpleVector 7

/-- The negative highest root in the fixed simple coordinates. -/
def a2Second : RootVector := #v[-2, -3, -4, -6, -5, -4, -3, -2]

/-- The six roots generated by the displayed two-root subsystem. -/
def a2Roots : Finset RootVector :=
  [a2First, a2Second, addVector a2First a2Second,
    negateVector a2First, negateVector a2Second,
    negateVector (addVector a2First a2Second)].toFinset

/-- The literal integral Cartan pairing of two coordinate vectors. -/
def rootPair (v w : RootVector) : ℤ :=
  ∑ i : Fin 8, ∑ j : Fin 8, v[i] * CartanMatrix.E₈ i j * w[j]

/-- A checked disjoint, orthogonal decomposition of every degree-zero root. -/
theorem e8_zero_root_decomposition_certificate :
    e6Roots.card = 72 ∧ a2Roots.card = 6 ∧
    zeroRoots = e6Roots ∪ a2Roots ∧ Disjoint e6Roots a2Roots ∧
    (∀ v ∈ e6Roots, ∀ w ∈ a2Roots, rootPair v w = 0) ∧
    rootPair a2First a2First = 2 ∧ rootPair a2Second a2Second = 2 ∧
    rootPair a2First a2Second = -1 := by
  native_decide

/-- The first six simple-coordinate directions. -/
def e6SimpleIndex (i : Fin 6) : Fin 8 := ⟨i.val, lt_trans i.isLt (by decide)⟩

/-- Their literal Cartan matrix is the standard six-node exceptional matrix. -/
theorem e8_e6_cartan_submatrix :
    CartanMatrix.E₈.submatrix e6SimpleIndex e6SimpleIndex = CartanMatrix.E₆ := by
  decide

end CubicAnomaly.Fixed.E8GradingData
