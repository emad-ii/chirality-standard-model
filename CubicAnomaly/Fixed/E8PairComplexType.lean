import CubicAnomaly.Fixed.E8CompactOrthogonal
import CubicAnomaly.Fixed.E8FamilyComplexStructure
import CubicAnomaly.Fixed.E8MatterIrreducible

/-!
# Complex type of the actual compact exceptional pair

The family polynomial forces every real intertwiner to be complex linear.
The compact zero algebra spans the full complex zero algebra, whose action
on degree one is now proved irreducible. Schur's lemma and the explicit
realification therefore identify the actual real complement's commutant
with `ℂ`.
-/

namespace CubicAnomaly.Fixed.E8PairComplexType

open CubicAnomaly.Classification.Structural
open CubicAnomaly.Fixed.E8Geck
open CubicAnomaly.Fixed.E8Grading
open CubicAnomaly.Fixed.E8Compact
open CubicAnomaly.Fixed.E8CompactGrading
open CubicAnomaly.Fixed.E8CompactPair
open CubicAnomaly.Fixed.E8MatterMatching
open CubicAnomaly.Fixed.E8MatterIrreducible
open CubicAnomaly.Fixed.E8FamilyComplexStructure
open CubicAnomaly.Fixed.PolynomialComplexStructure

noncomputable section

set_option maxHeartbeats 800000
set_option maxRecDepth 2048
set_option Elab.async false

instance compactMatterLieRingModule : LieRingModule compactZero ActualMatter :=
  LieRingModule.compLieHom ActualMatter compactZeroToComplex

instance compactMatterLieModule : LieModule ℝ compactZero ActualMatter :=
  LieModule.compLieHom ActualMatter compactZeroToComplex

theorem e8_compact_matter_action (x : compactZero) (v : ActualMatter) :
    ⁅x, v⁆ = ⁅compactZeroToComplex x, v⁆ := rfl

private theorem imaginary_family_fixed :
    compactConjugation (E8A2.sl3Embedding imaginaryFamilyWitness) =
      E8A2.sl3Embedding imaginaryFamilyWitness := by
  apply Subtype.ext
  apply operatorEquiv.injective
  rw [e8_compact_conjugation_operator, e8_imaginary_family_witness_skewAdjoint, neg_neg]

/-- The polynomial witness belongs to the actual compact degree-zero subalgebra. -/
def compactFamilyGenerator : compactZero :=
  ⟨compactOfFixed (E8A2.sl3Embedding imaginaryFamilyWitness) imaginary_family_fixed, by
    change compactToComplex (compactOfFixed _ imaginary_family_fixed) ∈ actualGrade 0
    rw [e8_compactToComplex_ofFixed]
    exact E8A2.e8_a2_sl3Embedding_mem_zero imaginaryFamilyWitness⟩

theorem e8_compact_family_generator_image :
    compactZeroToComplex compactFamilyGenerator =
      E8A2.sl3ZeroEmbedding imaginaryFamilyWitness := by
  apply Subtype.ext
  exact e8_compactToComplex_ofFixed _ imaginary_family_fixed

/-- Multiplication by `i` is already generated by one compact isotropy action. -/
theorem e8_compact_family_complex_structure (v : ActualMatter) :
    Complex.I • v = (3 / 2 : ℝ) • ⁅compactFamilyGenerator, v⁆ +
      (1 / 2 : ℝ) • ⁅compactFamilyGenerator,
        ⁅compactFamilyGenerator, ⁅compactFamilyGenerator, v⁆⁆⁆ := by
  simp only [e8_compact_matter_action, e8_compact_family_generator_image]
  exact e8_family_operator_complex_structure v

/-- The actual compact action on the real underlying exceptional half
has exactly the complex scalars as its full real commutant. -/
def actualHalfCommutantEquivComplex :
    lieCommutant (L := compactZero) (M := ActualMatter) ≃ₐ[ℝ] ℂ := by
  letI := e8_actualMatter_isIrreducible
  exact realCommutantEquivComplex compactZeroToComplex e8_compact_matter_action
    e8_zero_skew_parts compactFamilyGenerator e8_compact_family_complex_structure

/-- The actual realification is equivariant for the compact zero algebra. -/
def realificationLieEquiv : ActualMatter ≃ₗ⁅ℝ,compactZero⁆ compactComplement where
  __ := realificationEquiv
  map_lie' := by
    intro x v
    exact e8_realification_equivariant x v

/-- The entire actual 162-dimensional real adjoint complement has complex
commutant. This is the original complex-type condition on that complement. -/
def realComplementCommutantEquivComplex :
    lieCommutant (L := compactZero) (M := compactComplement) ≃ₐ[ℝ] ℂ :=
  (commutantTransport realificationLieEquiv).symm.trans actualHalfCommutantEquivComplex

/-- The actual real complement is irreducible under compact isotropy. -/
theorem e8_real_complement_irreducible :
    LieModule.IsIrreducible ℝ compactZero compactComplement := by
  letI : Nontrivial compactComplement := (Module.finrank_pos_iff
    (R := ℝ) (M := compactComplement)).mp (by
    rw [e8_compactComplement_finrank]
    decide)
  exact compact_complex_commutant_irreducible compactForm compactZero compactComplement
    realComplementCommutantEquivComplex

/-- The same realification targets the canonical orthogonal complement
used in the all-rank hypotheses. -/
def canonicalRealificationLieEquiv : ActualMatter ≃ₗ⁅ℝ,compactZero⁆
    orthogonalComplement compactForm compactZero := by
  rw [← e8_compactComplement_eq_orthogonal]
  exact realificationLieEquiv

/-- The original compact-pair complex-commutant hypothesis, on the exact
canonical complement appearing in the universal structural theorem. -/
def pairCommutantEquivComplex :
    lieCommutant (L := compactZero)
      (M := orthogonalComplement compactForm compactZero) ≃ₐ[ℝ] ℂ :=
  (commutantTransport canonicalRealificationLieEquiv).symm.trans
    actualHalfCommutantEquivComplex

/-- The chosen commutant orientation is the actual degree-one complex
structure, transported to the real complement. -/
theorem e8_canonical_realification_complex_structure (v : ActualMatter) :
    commutantComplexStructure pairCommutantEquivComplex
      (canonicalRealificationLieEquiv v) =
      canonicalRealificationLieEquiv (Complex.I • v) := by
  change ((commutantTransport canonicalRealificationLieEquiv)
    (actualHalfCommutantEquivComplex.symm Complex.I)).val
      (canonicalRealificationLieEquiv v) = _
  calc
    _ = canonicalRealificationLieEquiv
        ((actualHalfCommutantEquivComplex.symm Complex.I).val v) :=
      commutant_transport_apply_image canonicalRealificationLieEquiv
        (actualHalfCommutantEquivComplex.symm Complex.I) v
    _ = canonicalRealificationLieEquiv (Complex.I • v) := by
      apply congrArg canonicalRealificationLieEquiv
      letI := e8_actualMatter_isIrreducible
      exact real_commutant_equiv_symm_apply compactZeroToComplex e8_compact_matter_action
        e8_zero_skew_parts compactFamilyGenerator e8_compact_family_complex_structure
        Complex.I v

/-- The exact canonical real complement is irreducible. -/
theorem e8_canonical_complement_irreducible :
    LieModule.IsIrreducible ℝ compactZero (orthogonalComplement compactForm compactZero) := by
  rw [← e8_compactComplement_eq_orthogonal]
  exact e8_real_complement_irreducible

/-- Maximality follows from the actual irreducible complement. -/
theorem e8_compact_zero_maximal : IsCoatom compactZero := by
  letI := e8_real_complement_irreducible
  exact maximal_of_irreducible_complement compactZero compactComplement
    e8_compact_pair_isCompl e8_compactZero_ne_top

/-- A single endpoint records the actual pair's original complex-type
condition together with effectivity and properness. -/
theorem e8_compact_pair_complex_type :
    Effective compactZero ∧ compactZero ≠ ⊤ ∧
      Nonempty (lieCommutant (L := compactZero)
        (M := orthogonalComplement compactForm compactZero) ≃ₐ[ℝ] ℂ) :=
  ⟨e8_compact_pair_effective, e8_compactZero_ne_top, ⟨pairCommutantEquivComplex⟩⟩

end

end CubicAnomaly.Fixed.E8PairComplexType
