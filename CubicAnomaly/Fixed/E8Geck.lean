import CubicAnomaly.Fixed.E8Irreducible
import Mathlib.LinearAlgebra.RootSystem.GeckConstruction.Semisimple

/-!
# A concrete matrix Lie algebra built from the fixed exceptional roots

Geck's construction is applied to the actual root pairing constructed from
the checked `E₈` coordinate set.  In particular, the Lie bracket is the actual
matrix commutator and the generated algebra is finite dimensional.

The dimension `248` below is the dimension of its defining matrix space.
This file does not yet identify the generated Lie algebra's own dimension,
construct a compact real form, or construct the `E₆ + A₂` inclusion.
-/

namespace CubicAnomaly.Fixed.E8Geck

open CubicAnomaly.Fixed.E8RootPairing

noncomputable section

/-- The explicit simple coordinate base of the actual fixed root system. -/
abbrev base : rootPairing.Base := simpleBase

/-- The indices of the defining Geck representation. -/
abbrev Index := base.support ⊕ Root

/-- The actual vector space on which the fixed matrix construction acts. -/
abbrev DefiningSpace := Index → ℂ

/-- The actual Lie subalgebra generated by Geck's Cartan and raising/lowering matrices. -/
def lieAlgebra : LieSubalgebra ℂ (Matrix Index Index ℂ) :=
  RootPairing.GeckConstruction.lieAlgebra base

/-- Its distinguished abelian subalgebra. -/
def cartanSubalgebra : LieSubalgebra ℂ lieAlgebra :=
  RootPairing.GeckConstruction.cartanSubalgebra' base

instance : Fact ((4 - base.cartanMatrix).det ≠ 0) :=
  ⟨simpleBase_unsigned_cartan_det_ne_zero⟩

instance : Nonempty Root := ⟨simpleRoot 0⟩

theorem defining_space_irreducible :
    LieModule.IsIrreducible ℂ lieAlgebra DefiningSpace := by
  change LieModule.IsIrreducible ℂ (RootPairing.GeckConstruction.lieAlgebra base)
    (base.support ⊕ Root → ℂ)
  infer_instance

theorem lieAlgebra_hasTrivialRadical :
    LieAlgebra.HasTrivialRadical ℂ lieAlgebra := by
  change LieAlgebra.HasTrivialRadical ℂ (RootPairing.GeckConstruction.lieAlgebra base)
  infer_instance

theorem root_card : Fintype.card Root = 240 := by
  simpa using coordinateRoots_card

theorem base_card : Fintype.card base.support = 8 := by
  have h := Module.finrank_eq_card_basis base.toWeightBasis
  simpa using h.symm

theorem defining_space_finrank : Module.finrank ℂ DefiningSpace = 248 := by
  change Module.finrank ℂ (base.support ⊕ Root → ℂ) = 248
  rw [Module.finrank_fintype_fun_eq_card, Fintype.card_sum, base_card, root_card]

theorem lieAlgebra_finiteDimensional : FiniteDimensional ℂ lieAlgebra := inferInstance

theorem cartanSubalgebra_abelian : IsLieAbelian cartanSubalgebra := by
  change IsLieAbelian (RootPairing.GeckConstruction.cartanSubalgebra' base)
  infer_instance

theorem cartan_generator_mem (i : base.support) :
    RootPairing.GeckConstruction.h i ∈ lieAlgebra :=
  RootPairing.GeckConstruction.h_mem_lieAlgebra i

theorem raising_generator_mem (i : base.support) :
    RootPairing.GeckConstruction.e i ∈ lieAlgebra :=
  RootPairing.GeckConstruction.e_mem_lieAlgebra i

theorem lowering_generator_mem (i : base.support) :
    RootPairing.GeckConstruction.f i ∈ lieAlgebra :=
  RootPairing.GeckConstruction.f_mem_lieAlgebra i

end

end CubicAnomaly.Fixed.E8Geck
