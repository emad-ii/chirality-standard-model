import Mathlib.Algebra.Lie.Subalgebra

/-!
# Triangular span of Chevalley generators

If a Lie subalgebra acts diagonally on two families of generators, and every
mixed generator bracket belongs to that subalgebra, their generated algebra
is the vector-space sum of its negative, diagonal, and positive parts.
-/

namespace CubicAnomaly.Classification.ChevalleyTriangularSpan

open LieSubalgebra
variable {R L ι : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

private lemma swap_lie_mem (T : Submodule R L) {x y : L} (h : ⁅x, y⁆ ∈ T) : ⁅y, x⁆ ∈ T := by
  rw [← lie_skew y x]
  exact T.neg_mem h

/-- Extend a bound on a derivation from generators to their Lie span when
that span normalizes the target of the bound. -/
private lemma ad_span {S : Set L} (T : Submodule R L) (a : L)
    (ha : ∀ x ∈ S, ⁅a, x⁆ ∈ T)
    (hn : ∀ x ∈ lieSpan R L S, ∀ y ∈ T, ⁅x, y⁆ ∈ T)
    {x : L} (hx : x ∈ lieSpan R L S) : ⁅a, x⁆ ∈ T := by
  induction hx using lieSpan_induction with
  | mem => exact ha _ ‹_›
  | zero => simp
  | add x y _ _ hx hy => simpa only [lie_add] using T.add_mem hx hy
  | smul c x _ hx => simpa only [lie_smul] using T.smul_mem c hx
  | lie x y hx hy ix iy =>
    rw [leibniz_lie]
    exact T.add_mem (swap_lie_mem T (hn y hy _ ix)) (hn x hx _ iy)

private lemma ad_sup {U V T : Submodule R L} {a : L}
    (hu : ∀ x ∈ U, ⁅a, x⁆ ∈ T) (hv : ∀ y ∈ V, ⁅a, y⁆ ∈ T)
    {z : L} (hz : z ∈ U ⊔ V) : ⁅a, z⁆ ∈ T := by
  obtain ⟨x, hx, y, hy, rfl⟩ := Submodule.mem_sup.mp hz
  rw [lie_add]
  exact T.add_mem (hu x hx) (hv y hy)

private lemma span_part {S : Set L} (W : Submodule R L)
    (hgen : ∀ a ∈ S, a ∈ W ∧ ∀ y ∈ W, ⁅a, y⁆ ∈ W) :
    (lieSpan R L S).toSubmodule ≤ W := by
  let A : LieSubalgebra R L := {
    carrier := { a | a ∈ W ∧ ∀ y ∈ W, ⁅a, y⁆ ∈ W }
    add_mem' := fun ⟨ha, h₁⟩ ⟨hb, h₂⟩ => ⟨W.add_mem ha hb,
      fun y hy => by simpa only [add_lie] using W.add_mem (h₁ y hy) (h₂ y hy)⟩
    zero_mem' := ⟨W.zero_mem, fun _ _ => by simp⟩
    smul_mem' := fun c _ ⟨ha, h₁⟩ => ⟨W.smul_mem c ha,
      fun y hy => by simpa only [smul_lie] using W.smul_mem c (h₁ y hy)⟩
    lie_mem' := fun ⟨_, h₁⟩ ⟨hb, h₂⟩ => ⟨h₁ _ hb, fun y hy => by
      rw [lie_lie]
      exact W.sub_mem (h₁ _ (h₂ y hy)) (h₂ _ (h₁ y hy))⟩ }
  have hle : lieSpan R L S ≤ A := lieSpan_le.mpr hgen
  exact fun _ hx => (hle hx).1

private lemma diagonal_normalizes (H : LieSubalgebra R L) (v : ι → L)
    (hv : ∀ (h : H) i, ∃ c : R, ⁅(h : L), v i⁆ = c • v i)
    (h : H) {y : L} (hy : y ∈ lieSpan R L (Set.range v)) :
    ⁅(h : L), y⁆ ∈ lieSpan R L (Set.range v) := by
  let A := lieSpan R L (Set.range v)
  apply ad_span A.toSubmodule h _ (fun _ hx _ hy => A.lie_mem hx hy) hy
  rintro _ ⟨i, rfl⟩
  obtain ⟨c, hc⟩ := hv h i
  rw [hc]
  exact A.smul_mem c (subset_lieSpan ⟨i, rfl⟩)

private lemma mixed_normalizes (H : LieSubalgebra R L) (v : ι → L)
    (hv : ∀ (h : H) i, ∃ c : R, ⁅(h : L), v i⁆ = c • v i)
    (a : L) (ha : ∀ i, ⁅a, v i⁆ ∈ H) {y : L} (hy : y ∈ lieSpan R L (Set.range v)) :
    ⁅a, y⁆ ∈ (lieSpan R L (Set.range v)).toSubmodule ⊔ H.toSubmodule := by
  let A := lieSpan R L (Set.range v)
  apply ad_span (A.toSubmodule ⊔ H.toSubmodule) a _ _ hy
  · rintro _ ⟨i, rfl⟩
    exact (le_sup_right : H.toSubmodule ≤ A.toSubmodule ⊔ H.toSubmodule) (ha i)
  · intro x hx z hz
    apply (le_sup_left : A.toSubmodule ≤ A.toSubmodule ⊔ H.toSubmodule)
    exact ad_sup (fun _ mu => A.lie_mem hx mu)
      (fun h mh => swap_lie_mem A.toSubmodule (diagonal_normalizes H v hv ⟨h, mh⟩ hx)) hz

/-- The Lie algebra generated by the two families and the diagonal subalgebra
lies in the sum of their three separately generated vector spaces. -/
theorem generated_le_triangular (H : LieSubalgebra R L) (e f : ι → L)
    (he : ∀ (h : H) i, ∃ c : R, ⁅(h : L), e i⁆ = c • e i)
    (hf : ∀ (h : H) i, ∃ c : R, ⁅(h : L), f i⁆ = c • f i)
    (hef : ∀ i j, ⁅e i, f j⁆ ∈ H) :
    (lieSpan R L (Set.range f ∪ (H : Set L) ∪ Set.range e)).toSubmodule ≤
      (lieSpan R L (Set.range f)).toSubmodule ⊔ H.toSubmodule ⊔
      (lieSpan R L (Set.range e)).toSubmodule := by
  let N := lieSpan R L (Set.range f)
  let P := lieSpan R L (Set.range e)
  let W := N.toSubmodule ⊔ H.toSubmodule ⊔ P.toSubmodule
  have neg : N.toSubmodule ≤ W := le_sup_left.trans le_sup_left
  have diag : H.toSubmodule ≤ W := le_sup_right.trans le_sup_left
  have pos : P.toSubmodule ≤ W := le_sup_right
  have stable (a : L) (hn : ∀ n ∈ N, ⁅a,n⁆ ∈ W)
      (hh : ∀ h ∈ H, ⁅a,h⁆ ∈ W) (hp : ∀ p ∈ P, ⁅a,p⁆ ∈ W) :
      ∀ w ∈ W, ⁅a,w⁆ ∈ W :=
    fun _ hw => ad_sup (fun _ hz => ad_sup hn hh hz) hp hw
  apply span_part W
  rintro a ((⟨i, rfl⟩ | ha) | ⟨i, rfl⟩)
  · have hi : f i ∈ N := subset_lieSpan ⟨i, rfl⟩
    refine ⟨neg hi, stable _ (fun _ hn => neg (N.lie_mem hi hn)) ?_ ?_⟩
    · exact fun h hh => neg (swap_lie_mem N.toSubmodule (diagonal_normalizes H f hf ⟨h, hh⟩ hi))
    · exact fun _ hp => (sup_le pos diag) (mixed_normalizes H e he (f i)
        (fun j => swap_lie_mem H.toSubmodule (hef j i)) hp)
  · exact ⟨diag ha, stable _ (fun _ hn => neg (diagonal_normalizes H f hf ⟨a, ha⟩ hn))
      (fun _ hh => diag (H.lie_mem ha hh))
      (fun _ hp => pos (diagonal_normalizes H e he ⟨a, ha⟩ hp))⟩
  · have hi : e i ∈ P := subset_lieSpan ⟨i, rfl⟩
    exact ⟨pos hi, stable _ (fun _ hn => (sup_le neg diag) (mixed_normalizes H f hf (e i) (hef i) hn))
      (fun h hh => pos (swap_lie_mem P.toSubmodule (diagonal_normalizes H e he ⟨h, hh⟩ hi)))
      (fun _ hp => pos (P.lie_mem hi hp))⟩

end CubicAnomaly.Classification.ChevalleyTriangularSpan
