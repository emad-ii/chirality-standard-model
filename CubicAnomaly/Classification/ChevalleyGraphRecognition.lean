import CubicAnomaly.Classification.ChevalleyTriangularSpan
import CubicAnomaly.Classification.ChevalleyHeightSeparation
import CubicAnomaly.Classification.LieSubdirect

/-! # Recognition by matched generators

The subalgebra of a product generated by matched triples projects onto both
factors. Its height-zero part lies in the diagonal Cartan, so the subdirect
product is the graph of a Lie isomorphism carrying the prescribed generators
and Cartan to their partners.
-/

namespace CubicAnomaly.Classification.ChevalleyGraphRecognition

open LieSubalgebra CubicAnomaly.Fixed.TensorAnomaly
open ChevalleyHeightSeparation ChevalleyTriangularSpan LieSubdirect

variable {K L₁ L₂ ι : Type*} [Field K] [CharZero K]
  [LieRing L₁] [LieAlgebra K L₁] [LieRing L₂] [LieAlgebra K L₂]

omit [CharZero K] in
private lemma cartan_commute {L : Type*} [LieRing L] [LieAlgebra K L]
    {H : LieSubalgebra K L} [IsLieAbelian H] (x y : H) : ⁅(x : L), (y : L)⁆ = 0 :=
  congrArg Subtype.val (trivial_lie_zero H H x y)

private def diagHom {H₁ : LieSubalgebra K L₁} {H₂ : LieSubalgebra K L₂}
    [IsLieAbelian H₁] [IsLieAbelian H₂] (T : H₁ ≃ₗ[K] H₂) :
    H₁ →ₗ⁅K⁆ ProductLie L₁ L₂ where
  toFun h := (h.val, (T h).val)
  map_add' x y := Prod.ext rfl (congrArg Subtype.val (T.map_add x y))
  map_smul' c x := Prod.ext rfl (congrArg Subtype.val (T.map_smul c x))
  map_lie' {x y} := by
    apply Prod.ext
    · rfl
    change (T ⁅x, y⁆).val = ⁅(T x).val, (T y).val⁆
    rw [trivial_lie_zero, map_zero, cartan_commute]
    rfl

omit [CharZero K] in
private lemma onto_generated {S L : Type*} [LieRing S] [LieAlgebra K S]
    [LieRing L] [LieAlgebra K L] (p : S →ₗ⁅K⁆ L) (e f : ι → L)
    (hg : lieSpan K L (Set.range e ∪ Set.range f) = ⊤)
    (he : ∀ i, e i ∈ p.range) (hf : ∀ i, f i ∈ p.range) : Function.Surjective p := by
  have hle : lieSpan K L (Set.range e ∪ Set.range f) ≤ p.range := by
    apply lieSpan_le.mpr
    rintro _ (⟨i, rfl⟩ | ⟨i, rfl⟩)
    exacts [he i, hf i]
  exact fun x => (p.mem_range x).mp (hle (hg ▸ LieSubalgebra.mem_top x))

/-- Matching the Cartan weights and all mixed generator brackets suffices to
recognize the Lie algebra, with the specified values of the isomorphism. -/
theorem exists_equiv_of_matched_generators [LieAlgebra.IsSimple K L₁] [LieAlgebra.IsSimple K L₂]
    (H₁ : LieSubalgebra K L₁) (H₂ : LieSubalgebra K L₂)
    [IsLieAbelian H₁] [IsLieAbelian H₂] [Nontrivial H₁] (T : H₁ ≃ₗ[K] H₂)
    (e₁ f₁ : ι → L₁) (e₂ f₂ : ι → L₂)
    (he : ∀ (h : H₁) i, ∃ c : K, ⁅h.val,e₁ i⁆ = c • e₁ i ∧ ⁅(T h).val,e₂ i⁆ = c • e₂ i)
    (hf : ∀ (h : H₁) i, ∃ c : K, ⁅h.val,f₁ i⁆ = c • f₁ i ∧ ⁅(T h).val,f₂ i⁆ = c • f₂ i)
    (hef : ∀ i j, ∃ h : H₁, ⁅e₁ i, f₁ j⁆ = h.val ∧ ⁅e₂ i, f₂ j⁆ = (T h).val)
    (t : H₁) (hte : ∀ i, ⁅t.val,e₁ i⁆ = e₁ i) (htf : ∀ i, ⁅t.val,f₁ i⁆ = -f₁ i)
    (hne : ∀ i, e₁ i ≠ 0) (hnf : ∀ i, f₁ i ≠ 0)
    (hg₁ : lieSpan K L₁ (Set.range e₁ ∪ Set.range f₁) = ⊤)
    (hg₂ : lieSpan K L₂ (Set.range e₂ ∪ Set.range f₂) = ⊤) :
    ∃ Φ : L₁ ≃ₗ⁅K⁆ L₂, (∀ h : H₁, Φ h.val = (T h).val) ∧
      (∀ i, Φ (e₁ i) = e₂ i) ∧ ∀ i, Φ (f₁ i) = f₂ i := by
  let d := diagHom T
  let D := d.range
  let E (i : ι) : ProductLie L₁ L₂ := (e₁ i, e₂ i)
  let F (i : ι) : ProductLie L₁ L₂ := (f₁ i, f₂ i)
  let S := lieSpan K (ProductLie L₁ L₂) (Set.range F ∪ (D : Set _) ∪ Set.range E)
  have ein (i : ι) : E i ∈ S := subset_lieSpan (Or.inr ⟨i, rfl⟩)
  have fin (i : ι) : F i ∈ S := subset_lieSpan (Or.inl (Or.inl ⟨i, rfl⟩))
  have hin (h : H₁) : d h ∈ S := subset_lieSpan (Or.inl (Or.inr (d.mem_range_self h)))
  let p₁ : S →ₗ⁅K⁆ L₁ := {
    toFun := fun x => x.val.1
    map_add' := fun _ _ => rfl
    map_smul' := fun _ _ => rfl
    map_lie' := rfl }
  let p₂ : S →ₗ⁅K⁆ L₂ := {
    toFun := fun x => x.val.2
    map_add' := fun _ _ => rfl
    map_smul' := fun _ _ => rfl
    map_lie' := rfl }
  obtain htop | ⟨Φ, hΦ⟩ := full_or_graph S
    (onto_generated p₁ e₁ f₁ hg₁ (fun i => p₁.mem_range_self ⟨_, ein i⟩)
      (fun i => p₁.mem_range_self ⟨_, fin i⟩))
    (onto_generated p₂ e₂ f₂ hg₂ (fun i => p₂.mem_range_self ⟨_, ein i⟩)
      (fun i => p₂.mem_range_self ⟨_, fin i⟩))
  · exfalso
    have tri := generated_le_triangular D E F (by
      rintro ⟨x, hx⟩ i
      obtain ⟨h, rfl⟩ := (d.mem_range _).mp hx
      obtain ⟨c, hc, hc'⟩ := he h i
      exact ⟨c, Prod.ext hc hc'⟩) (by
      rintro ⟨x, hx⟩ i
      obtain ⟨h, rfl⟩ := (d.mem_range _).mp hx
      obtain ⟨c, hc, hc'⟩ := hf h i
      exact ⟨c, Prod.ext hc hc'⟩) (by
      intro i j
      obtain ⟨h, h₁, h₂⟩ := hef i j
      exact (d.mem_range _).mpr ⟨h, Prod.ext h₁.symm h₂.symm⟩)
    obtain ⟨u, hu⟩ := exists_ne (0 : H₁)
    let x : ProductLie L₁ L₂ := (u.val, 0)
    have hx : x ∈ S := htop ▸ LieSubalgebra.mem_top x
    have hxD := triangular_height_zero_mem (d t) D.toSubmodule (by
      intro y hy
      obtain ⟨h, rfl⟩ := (d.mem_range _).mp hy
      exact Prod.ext (cartan_commute t h) (cartan_commute (T t) (T h))) E F (by
      intro i
      obtain ⟨c, h₁, h₂⟩ := he t i
      have hc : c = 1 := smul_left_injective K (hne i) (by simpa using h₁.symm.trans (hte i))
      exact Prod.ext (hte i) (by simpa [hc] using h₂)) (by
      intro i
      obtain ⟨c, h₁, h₂⟩ := hf t i
      have hc : c = -1 := smul_left_injective K (hnf i) (by simpa using h₁.symm.trans (htf i))
      exact Prod.ext (htf i) (by simpa [hc] using h₂))
      (x := x) (Prod.ext (cartan_commute t u) (lie_zero _)) (tri hx)
    obtain ⟨h, hh⟩ := (d.mem_range _).mp hxD
    have h₁ : h = u := Subtype.ext (congrArg Prod.fst hh)
    have h₂ : T h = 0 := Subtype.ext (congrArg Prod.snd hh)
    exact hu (h₁ ▸ T.map_eq_zero_iff.mp h₂)
  · exact ⟨Φ, fun h => hΦ ⟨_, hin h⟩, fun i => hΦ ⟨_, ein i⟩, fun i => hΦ ⟨_, fin i⟩⟩

end CubicAnomaly.Classification.ChevalleyGraphRecognition
