import Mathlib.Algebra.Lie.Semisimple.Basic
import Mathlib.RepresentationTheory.AlgebraRepresentation.Basic
import Mathlib.RingTheory.SimpleModule.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
# Associative density of an actual irreducible Lie action

Over an algebraically closed field, a finite-dimensional irreducible Lie
action generates the entire endomorphism algebra. The proof regards any
associative subalgebra containing the actual action as a simple-module
algebra, applies Schur's lemma, and then uses Jacobson density.

No universal-enveloping identification, classification, or density witness
is an input. This permits tensor-subspace arguments to replace the actual
Lie action on one factor by arbitrary endomorphisms of that factor.
-/

namespace CubicAnomaly.Classification.LieDensity

open Module LieModule

variable {K L M : Type*} [Field K] [LieRing L] [LieAlgebra K L]
  [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  [LieModule.IsIrreducible K L M]

private theorem isSimpleModule_of_lie_action_mem
    (A : Subalgebra K (Module.End K M))
    (hA : ∀ x : L, toEnd K L M x ∈ A) : IsSimpleModule A M := by
  letI : Nontrivial M := LieModule.nontrivial_of_isIrreducible K L M
  refine (isSimpleModule_iff A M).mpr ⟨fun U => ?_⟩
  let N : LieSubmodule K L M := {
    U.restrictScalars K with
    lie_mem := by
      intro x m hm
      exact U.smul_mem (⟨toEnd K L M x, hA x⟩ : A) hm }
  rcases IsSimpleOrder.eq_bot_or_eq_top N with hN | hN
  · left
    ext m
    change m ∈ N ↔ m = 0
    rw [hN, LieSubmodule.mem_bot]
  · right
    ext m
    change m ∈ N ↔ True
    rw [hN]
    simp

/-- Every associative subalgebra containing an actual finite-dimensional
irreducible Lie action over an algebraically closed field is the entire
endomorphism algebra. -/
theorem subalgebra_eq_top_of_lie_action_mem
    [FiniteDimensional K M] [IsAlgClosed K]
    (A : Subalgebra K (Module.End K M))
    (hA : ∀ x : L, toEnd K L M x ∈ A) : A = ⊤ := by
  classical
  letI : IsSimpleModule A M := isSimpleModule_of_lie_action_mem A hA
  have hscalar : Function.Surjective (algebraMap K (Module.End A M)) :=
    (IsSimpleModule.algebraMap_end_bijective_of_isAlgClosed K).2
  letI : Module.Finite (Module.End A M) M := Module.Finite.of_restrictScalars_finite K _ _
  apply top_unique
  intro T _
  let F : Module.End (Module.End A M) M := {
    toFun := T
    map_add' := T.map_add
    map_smul' := by
      intro d m
      obtain ⟨a, rfl⟩ := hscalar d
      simpa only [algebraMap_smul] using T.map_smul a m }
  obtain ⟨a, ha⟩ := Module.Finite.toModuleEnd_moduleEnd_surjective (R := A) (M := M) F
  have hT : (a : Module.End K M) = T := by
    ext m
    exact congrArg (fun f : Module.End (Module.End A M) M => f m) ha
  exact hT ▸ a.property

/-- The associative algebra generated by the actual Lie action is all
endomorphisms. This is a conclusion of irreducibility and algebraic closure. -/
theorem lie_action_adjoin_eq_top [FiniteDimensional K M] [IsAlgClosed K] :
    Algebra.adjoin K (Set.range (toEnd K L M)) = ⊤ := by
  apply subalgebra_eq_top_of_lie_action_mem (L := L)
  intro x
  exact Algebra.subset_adjoin ⟨x, rfl⟩

end CubicAnomaly.Classification.LieDensity
