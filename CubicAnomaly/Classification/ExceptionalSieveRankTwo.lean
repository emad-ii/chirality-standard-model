import CubicAnomaly.Classification.ExceptionalSieveRankOne
import CubicAnomaly.Classification.RootClassificationExceptional

/-!
# The smaller-rank dimension sieve at ambient dimension 52

Rank parity and exclusion of rank one force the actual isotropy rank to be
two. The two off-diagonal simple-root pairings then determine both the root
table and the dual coroot table. The dimension test below evaluates the Weyl
product directly on the positive coroots for every possible bounded label.
-/

namespace CubicAnomaly.Classification.ExceptionalSieveRankTwo

open LieAlgebra LieModule Module LieAlgebra.IsKilling
open CubicAnomaly.Classification.Exceptional
open CubicAnomaly.Classification.RootClassificationExceptional
open CubicAnomaly.Classification.ExceptionalSieveWeights

private def off : Fin 6 → ℤ × ℤ :=
  ![(0, 0), (-1, -1), (-1, -2), (-2, -1), (-1, -3), (-3, -1)]

private def datumFromOff (p : ℤ × ℤ) : RootDatum :=
  { cartan := #[#[2, p.1], #[p.2, 2]]
    symmetrizer := if p.1 = 0 then #[1, 1] else #[p.1.natAbs, p.2.natAbs] }

/-- The six oriented Cartan matrices of rank two (including the reducible matrix). -/
def datum (k : Fin 6) := datumFromOff (off k)

/-- Transposing a simple Cartan matrix yields the dual coroot datum. -/
def dualDatum (k : Fin 6) := datumFromOff (off k).swap

theorem rank_two_tables_certified :
    ∀ k : Fin 6, Certified (datum k) ∧ Certified (dualDatum k) := by native_decide

private def positiveCoroots (k : Fin 6) :=
  (table (dualDatum k)).filter fun v => (0 : ℤ) ≤ v.get (0 : Fin 2) ∧ (0 : ℤ) ≤ v.get (1 : Fin 2)

/-- Cross-multiplied Weyl dimension equation; the positive-coroot list is
generated by simple reflections in the transposed Cartan matrix. -/
def WeylDimension (k : Fin 6) (a b N : ℕ) : Prop :=
  (∏ v ∈ positiveCoroots k, (v.get (0 : Fin 2) * (a + 1) + v.get (1 : Fin 2) * (b + 1) : ℤ)) =
    (N : ℤ) * ∏ v ∈ positiveCoroots k, (v.get (0 : Fin 2) + v.get (1 : Fin 2))

instance (k : Fin 6) (a b N : ℕ) : Decidable (WeylDimension k a b N) := by
  unfold WeylDimension
  infer_instance

/-- No Weyl dimension in the complete two-label box equals the dimension
required by a 52-dimensional ambient algebra. For a disconnected root system
the test requires both simple factors to act nontrivially. -/
theorem rank_two_f4_weyl_sieve : ∀ (k : Fin 6) (a b : Fin 23),
    (k = 0 → a ≠ 0 ∧ b ≠ 0) →
    ¬WeylDimension k a b ((52 - (2 + (table (datum k)).card)) / 2) := by
  native_decide

section Lie

variable {L : Type*} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
  [LieAlgebra.IsKilling ℂ L] (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]

private theorem eq_off_of_distinct (B : (rootSystem H).Base) (i j : B.support) (hij : i ≠ j) :
    ∃ k, (B.cartanMatrix i j, B.cartanMatrix j i) = off k := by
  have hle := B.cartanMatrix_le_zero_of_ne i j hij
  have hle' := B.cartanMatrix_le_zero_of_ne j i hij.symm
  have hli := B.linearIndependent_pair_of_ne hij
  have hne := ((rootSystem H).linearIndependent_iff_coxeterWeightIn_ne_four ℤ).mp hli
  change B.cartanMatrix i j * B.cartanMatrix j i ≠ 4 at hne
  have hp := (rootSystem H).pairingIn_pairingIn_mem_set_of_isCrystal_of_isRed i.val j.val
  change (B.cartanMatrix i j, B.cartanMatrix j i) ∈ _ at hp
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Prod.mk.injEq] at hp
  rcases hp with h | h | h | h | h | h | h | h | h | h | h | h | h
  all_goals obtain ⟨h1, h2⟩ := h
  all_goals rw [h1, h2] at hne ⊢
  all_goals first | decide | omega


/-- Classification of the actual roots of an arbitrary rank-two Killing
algebra into the six oriented tables. Only the Cartan dimension is input. -/
theorem actual_rank_two_cartan_table (B : (rootSystem H).Base) (hr : finrank ℂ H = 2) :
    ∃ (k : Fin 6) (s : Index (datum k) ≃ B.support),
      (∀ i j, B.cartanMatrix (s i) (s j) = matrix (datum k) i j) ∧
      finrank ℂ L = 2 + (table (datum k)).card := by
  have hc : Fintype.card B.support = 2 := by
    rw [← finrank_eq_card_basis B.toWeightBasis, Subspace.dual_finrank_eq, hr]
  let s : Fin 2 ≃ B.support := (Fintype.equivFinOfCardEq hc).symm
  obtain ⟨k, hk⟩ := eq_off_of_distinct H B (s 0) (s 1) (fun h => by simpa using s.injective h)
  have hm : ∀ i j : Fin 2, B.cartanMatrix (s i) (s j) = matrix (datum k) i j := by
    intro i j
    fin_cases i <;> fin_cases j
    · exact B.cartanMatrix_apply_same _
    · exact congrArg Prod.fst hk
    · exact congrArg Prod.snd hk
    · exact B.cartanMatrix_apply_same _
  obtain ⟨E, -⟩ := exists_census_root_equiv B (d := datum k) s (rank_two_tables_certified k).1 hm
  refine ⟨k, s, hm, ?_⟩
  rw [KillingDimension.killing_finrank_eq_cartan_add_roots H,
    KillingDimension.actual_root_count_eq_card H, hr, ← Fintype.card_congr E, Fintype.card_coe]

end Lie

section CompactPair

open scoped TensorProduct
open CubicAnomaly.Classification.Structural
open CubicAnomaly.Classification.Complexification
open CubicAnomaly.Classification.CompactGeometry
open CubicAnomaly.Classification.CompactCartan
open CubicAnomaly.Classification.ComplexDuality
open CubicAnomaly.Classification.HermitianRealization
open CubicAnomaly.Classification.SieveBounds
open CubicAnomaly.Classification.ExceptionalSieveRankOne

variable {g : Type*} [LieRing g] [LieAlgebra ℝ g] [Module.Finite ℝ g]

set_option maxHeartbeats 800000 in
/-- At ambient dimension 52 and isotropy rank below four, every original pair
would supply an indexed rank-two root table and actual dominant labels. The
only alternatives are a zero label on a disconnected factor or failure of
the corresponding two-label Weyl dimension equation. -/
theorem compact_pair_f4_rank_two_sieve
    (B : CompactForm g) (h : LieSubalgebra ℝ g) (heff : Effective h) (hproper : h ≠ ⊤)
    (e : lieCommutant (L := h) (M := orthogonalComplement B h) ≃ₐ[ℝ] ℂ)
    (hradical : (hermitianHalfOfCommutant B h e).cubicRadical ≠ ⊥)
    (hg : finrank ℝ g = 52) (hr : abelianRank ℝ h < 4) :
    let V := invariantEigenspace (complexifiedEnd (commutantComplexStructure e)) Complex.I
    ∃ hK : LieAlgebra.IsKilling ℂ (ℂ ⊗[ℝ] h),
      letI := hK
      ∃ (H : LieSubalgebra ℂ (ℂ ⊗[ℝ] h)) (hH : H.IsCartanSubalgebra),
        letI := hH
        ∃ (b : (rootSystem H).Base) (k : Fin 6) (s : Index (datum k) ≃ b.support)
          (χ : Weight ℂ H V) (v : V) (a₀ a₁ : Fin 23),
          (∀ i j, b.cartanMatrix (s i) (s j) = matrix (datum k) i j) ∧
          v ≠ 0 ∧ (∀ x : H, ⁅x, v⁆ = χ x • v) ∧
          (∀ α : H.root, b.IsPos α → ∀ x ∈ rootSpace H α.val, ⁅x, v⁆ = 0) ∧
          χ (coroot (s (0 : Fin 2)).val.val) = ((a₀ : ℕ) : ℂ) ∧
          χ (coroot (s (1 : Fin 2)).val.val) = ((a₁ : ℕ) : ℂ) ∧
          ((k = 0 ∧ (a₀ = 0 ∨ a₁ = 0)) ∨ ¬WeylDimension k a₀ a₁ (finrank ℂ V)) := by
  classical
  let V := invariantEigenspace (complexifiedEnd (commutantComplexStructure e)) Complex.I
  have hlo := all_rank_isotropy_rank_ge_two B h heff hproper e hradical
  obtain ⟨A, hA, hdim⟩ := exists_abelian_finrank_eq_abelianRank ℝ h
  letI := hA
  letI : A.IsCartanSubalgebra := compact_maximum_abelian_isCartan (B.restrict h) A hdim
  let H := complexifiedSubalgebra A
  letI hH : H.IsCartanSubalgebra := complexified_abelian_cartan A
  letI : LieAlgebra.IsSemisimple ℝ h :=
    (all_rank_structural_reduction_of_commutant B h heff hproper e hradical).2.2.2.1
  letI hK : LieAlgebra.IsKilling ℂ (ℂ ⊗[ℝ] h) :=
    compact_complexification_isKilling (B.restrict h) (LieAlgebra.center_eq_bot ℝ h)
  have hHdim : finrank ℂ H = abelianRank ℝ h := by
    change finrank ℂ (A.toSubmodule.baseChange ℂ) = _
    rw [complexification_submodule_finrank]
    exact hdim
  have hp := KillingDimension.killing_dimension_parity H
  rw [Module.finrank_baseChange, hHdim] at hp
  have htotal := QuadraticRestriction.compact_pair_dimension_equation B h hproper e
  change finrank ℝ g = finrank ℝ h + 2 * finrank ℂ V at htotal
  have hrank : finrank ℂ H = 2 := by omega
  obtain ⟨b⟩ := RootPairing.nonempty_base (rootSystem H)
  obtain ⟨k, s, hm, hdimh⟩ := actual_rank_two_cartan_table H b hrank
  rw [Module.finrank_baseChange] at hdimh
  letI : IsIrreducible ℂ (ℂ ⊗[ℝ] h) V :=
    (compact_complement_complex_type_decomposition B h hproper e).2.1
  letI : Nontrivial V := nontrivial_of_isIrreducible ℂ (ℂ ⊗[ℝ] h) V
  obtain ⟨χ, v, a, hv, hev, hkill, hlabels⟩ := exists_bounded_dominant_highest_weight (M := V) H b
  have hcap : finrank ℂ V ≤ 23 :=
    (all_rank_exceptional_size_half_bounds B h heff hproper e hradical).1 hg
  let a₀ : Fin 23 := (a (s (0 : Fin 2))).castLE hcap
  let a₁ : Fin 23 := (a (s (1 : Fin 2))).castLE hcap
  refine ⟨hK, H, hH, b, k, s, χ, v, a₀, a₁, hm, hv, hev, hkill, hlabels _, hlabels _, ?_⟩
  by_cases hbad : k = 0 ∧ (a₀ = 0 ∨ a₁ = 0)
  · exact Or.inl hbad
  · right
    have h := rank_two_f4_weyl_sieve k a₀ a₁ (by tauto)
    rwa [show finrank ℂ V = (52 - (2 + (table (datum k)).card)) / 2 by omega]

end CompactPair

end CubicAnomaly.Classification.ExceptionalSieveRankTwo
