import CubicAnomaly.Classification.DualPairSkew
import CubicAnomaly.Classification.TensorFormFactorization

/-!
# The skew endomorphism line of two self-dual blocks and one dual pair

This module works with actual equivariant inclusions and projections. Two
inequivalent self-dual irreducible blocks contribute no equivariant skew
endomorphisms. An inequivalent irreducible dual pair contributes precisely
the line generated by its sign operator. All orthogonality and restricted
nondegeneracy facts are derived from the invariant ambient form.
-/

namespace CubicAnomaly.Classification.UnitarySkewLine

open Module LieModule Submodule
open CubicAnomaly.Classification.SelfDualAbsorption
open CubicAnomaly.Classification.DualPairSkew
open CubicAnomaly.Classification.TensorFormFactorization

noncomputable section

section HomVanishing

variable {K L S T : Type*} [Field K] [LieRing L] [LieAlgebra K L]
  [AddCommGroup S] [Module K S] [LieRingModule L S] [LieModule K L S]
  [AddCommGroup T] [Module K T] [LieRingModule L T] [LieModule K L T]

omit [LieAlgebra K L] [LieModule K L S] [LieModule K L T] in
/-- Inequivalent irreducible modules admit no nonzero equivariant map. -/
theorem irreducible_hom_eq_zero_of_not_equiv
    [LieModule.IsIrreducible K L S] [LieModule.IsIrreducible K L T]
    (hne : ¬ Nonempty (S ≃ₗ⁅K,L⁆ T)) (f : S →ₗ⁅K,L⁆ T) : f = 0 := by
  by_contra hf
  have hinj : Function.Injective f := by
    apply (LieModuleHom.ker_eq_bot f).mp
    rcases IsSimpleOrder.eq_bot_or_eq_top f.ker with h | h
    · exact h
    · exact (hf (by
        ext s
        have hs : s ∈ f.ker := by rw [h]; trivial
        exact hs)).elim
  have hsurj : Function.Surjective f := by
    apply (LieModuleHom.range_eq_top f).mp
    rcases IsSimpleOrder.eq_bot_or_eq_top f.range with h | h
    · exact (hf (by
        ext s
        have hs : f s ∈ f.range := ⟨s, rfl⟩
        simpa only [h, LieSubmodule.mem_bot] using hs)).elim
    · exact h
  exact hne ⟨{ f, LinearEquiv.ofBijective f.toLinearMap ⟨hinj, hsurj⟩ with }⟩

private theorem self_dual_not_equiv_of_not_self_dual
    (hs : Nonempty (S ≃ₗ⁅K,L⁆ Module.Dual K S))
    (ht : ¬ Nonempty (T ≃ₗ⁅K,L⁆ Module.Dual K T)) : ¬ Nonempty (S ≃ₗ⁅K,L⁆ T) := by
  rintro ⟨e⟩
  obtain ⟨s⟩ := hs
  exact ht ⟨e.symm.trans (s.trans (contragredientEquiv e).symm)⟩

end HomVanishing

section Pair

variable {K L M : Type*} [Field K] [LieRing L] [LieAlgebra K L]
  [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]

private def summandProjection (P Q : LieSubmodule K L M) (hc : IsCompl P Q) :
    M →ₗ⁅K,L⁆ P where
  __ := P.toSubmodule.linearProjOfIsCompl Q.toSubmodule
    (LieSubmodule.isCompl_toSubmodule.mpr hc)
  map_lie' := by
    intro x m
    apply Subtype.ext
    let hc' := LieSubmodule.isCompl_toSubmodule.mpr hc
    change hc'.projection ⁅x, m⁆ = ⁅x, hc'.projection m⁆
    have hm : m ∈ P ⊔ Q := by rw [hc.sup_eq_top]; trivial
    obtain ⟨p, hp, q, hq, rfl⟩ := (LieSubmodule.mem_sup P Q m).mp hm
    have hp' := (hc'.projection_eq_self_iff p).mpr hp
    have hq' := hc'.projection_apply_eq_zero_iff.mpr hq
    have hxp := (hc'.projection_eq_self_iff ⁅x, p⁆).mpr (P.lie_mem hp)
    have hxq := hc'.projection_apply_eq_zero_iff.mpr (Q.lie_mem (x := x) hq)
    simp only [lie_add, map_add, hp', hq', hxp, hxq, add_zero]

omit [LieAlgebra K L] [LieModule K L M] in
private theorem summand_projection_add (P Q : LieSubmodule K L M) (hc : IsCompl P Q)
    (m : M) : (summandProjection P Q hc m : M) +
      (summandProjection Q P hc.symm m : M) = m :=
  (LieSubmodule.isCompl_toSubmodule.mpr hc).projection_add_projection_eq_self m

omit [LieAlgebra K L] [LieModule K L M] in
private theorem pair_sign_left (P Q : LieSubmodule K L M) (hc : IsCompl P Q) (p : P) :
    dualPairSign P Q hc p = p := by
  change (P.toSubmodule.linearProjOfIsCompl Q.toSubmodule
    (LieSubmodule.isCompl_toSubmodule.mpr hc) p : M) -
    (Q.toSubmodule.linearProjOfIsCompl P.toSubmodule
      (LieSubmodule.isCompl_toSubmodule.mpr hc.symm) p : M) = p
  rw [Submodule.linearProjOfIsCompl_apply_left, Submodule.linearProjOfIsCompl_apply_right]
  simp

omit [LieAlgebra K L] [LieModule K L M] in
private theorem pair_sign_right (P Q : LieSubmodule K L M) (hc : IsCompl P Q) (q : Q) :
    dualPairSign P Q hc q = -q := by
  change (P.toSubmodule.linearProjOfIsCompl Q.toSubmodule
    (LieSubmodule.isCompl_toSubmodule.mpr hc) q : M) -
    (Q.toSubmodule.linearProjOfIsCompl P.toSubmodule
      (LieSubmodule.isCompl_toSubmodule.mpr hc.symm) q : M) = -q
  rw [Submodule.linearProjOfIsCompl_apply_right, Submodule.linearProjOfIsCompl_apply_left]
  simp

/-- A map from an inequivalent irreducible dual pair to a self-dual
irreducible module vanishes. -/
theorem dual_pair_hom_to_self_dual_eq_zero [Module.Finite K M]
    {S : Type*} [AddCommGroup S] [Module K S] [LieRingModule L S] [LieModule K L S]
    [LieModule.IsIrreducible K L S]
    (P Q : LieSubmodule K L M) (hc : IsCompl P Q)
    [LieModule.IsIrreducible K L P] [LieModule.IsIrreducible K L Q]
    (d : Q ≃ₗ⁅K,L⁆ Module.Dual K P) (hne : ¬Nonempty (P ≃ₗ⁅K,L⁆ Q))
    (hs : Nonempty (S ≃ₗ⁅K,L⁆ Module.Dual K S)) (f : M →ₗ⁅K,L⁆ S) : f = 0 := by
  have hns := inequivalent_dual_pair_not_self_dual d hne
  have hPS : ¬Nonempty (P ≃ₗ⁅K,L⁆ S) := by
    rintro ⟨e⟩
    exact self_dual_not_equiv_of_not_self_dual hs hns.1 ⟨e.symm⟩
  have hQS : ¬Nonempty (Q ≃ₗ⁅K,L⁆ S) := by
    rintro ⟨e⟩
    exact self_dual_not_equiv_of_not_self_dual hs hns.2 ⟨e.symm⟩
  have hp := irreducible_hom_eq_zero_of_not_equiv hPS (f.comp P.incl)
  have hq := irreducible_hom_eq_zero_of_not_equiv hQS (f.comp Q.incl)
  ext m
  have hm : m ∈ P ⊔ Q := by rw [hc.sup_eq_top]; trivial
  obtain ⟨p, hp', q, hq', rfl⟩ := (LieSubmodule.mem_sup P Q m).mp hm
  have hfp : f p = 0 := congrArg (fun F : P →ₗ⁅K,L⁆ S => F ⟨p, hp'⟩) hp
  have hfq : f q = 0 := congrArg (fun F : Q →ₗ⁅K,L⁆ S => F ⟨q, hq'⟩) hq
  simp only [map_add, hfp, hfq, add_zero, LieModuleHom.zero_apply]

private theorem pair_end_diagonal [IsAlgClosed K] [Module.Finite K M]
    (P Q : LieSubmodule K L M) (hc : IsCompl P Q)
    [LieModule.IsIrreducible K L P] [LieModule.IsIrreducible K L Q]
    (hne : ¬Nonempty (P ≃ₗ⁅K,L⁆ Q)) (D : M →ₗ⁅K,L⁆ M) :
    ∃ c d : K, (∀ p : P, D p = c • (p : M)) ∧ (∀ q : Q, D q = d • (q : M)) := by
  have hne' : ¬Nonempty (Q ≃ₗ⁅K,L⁆ P) := by
    rintro ⟨e⟩
    exact hne ⟨e.symm⟩
  have hPQ := irreducible_hom_eq_zero_of_not_equiv hne
    ((summandProjection Q P hc.symm).comp (D.comp P.incl))
  have hQP := irreducible_hom_eq_zero_of_not_equiv hne'
    ((summandProjection P Q hc).comp (D.comp Q.incl))
  obtain ⟨c, hc'⟩ := equivariant_end_eq_smul_id
    ((summandProjection P Q hc).comp (D.comp P.incl))
  obtain ⟨d, hd'⟩ := equivariant_end_eq_smul_id
    ((summandProjection Q P hc.symm).comp (D.comp Q.incl))
  refine ⟨c, d, ?_, ?_⟩
  · intro p
    have hp : (summandProjection P Q hc (D p) : M) = c • (p : M) :=
      congrArg (fun F : P →ₗ⁅K,L⁆ P => (F p : M)) hc'
    have hq : (summandProjection Q P hc.symm (D p) : M) = 0 :=
      congrArg (fun F : P →ₗ⁅K,L⁆ Q => (F p : M)) hPQ
    rw [← summand_projection_add P Q hc (D p), hp, hq, add_zero]
  · intro q
    have hp : (summandProjection P Q hc (D q) : M) = 0 :=
      congrArg (fun F : Q →ₗ⁅K,L⁆ P => (F q : M)) hQP
    have hq : (summandProjection Q P hc.symm (D q) : M) = d • (q : M) :=
      congrArg (fun F : Q →ₗ⁅K,L⁆ Q => (F q : M)) hd'
    rw [← summand_projection_add P Q hc (D q), hp, hq, zero_add]

/-- The equivariant operators skew for an invariant nondegenerate form
on an inequivalent irreducible dual pair are exactly multiples of its
actual sign operator. -/
theorem dual_pair_skew_end_eq_smul_sign [IsAlgClosed K] [Module.Finite K M]
    (P Q : LieSubmodule K L M) (hc : IsCompl P Q)
    [LieModule.IsIrreducible K L P] [LieModule.IsIrreducible K L Q]
    (d : Q ≃ₗ⁅K,L⁆ Module.Dual K P) (hne : ¬Nonempty (P ≃ₗ⁅K,L⁆ Q))
    (Φ : LinearMap.BilinForm K M) (hi : Φ.lieInvariant L) (hnd : Φ.Nondegenerate)
    (D : M →ₗ⁅K,L⁆ M) (hD : ∀ x y, Φ (D x) y = -Φ x (D y)) :
    ∃ c : K, D = c • dualPairSign P Q hc := by
  obtain ⟨c, a, hP, hQ⟩ := pair_end_diagonal P Q hc hne D
  have hns := inequivalent_dual_pair_not_self_dual d hne
  have hPP : ∀ p p' : P, Φ p p' = 0 := by
    have h := invariant_form_eq_zero_of_not_self_dual hns.1 (Φ.restrict P.toSubmodule)
      (fun z p p' => hi z p p')
    intro p p'
    exact congrArg (fun B : LinearMap.BilinForm K P => B p p') h
  letI : Nontrivial P := LieModule.nontrivial_of_isIrreducible K L P
  obtain ⟨p, hp⟩ := exists_ne (0 : P)
  have hcross : ∃ q : Q, Φ p q ≠ 0 := by
    by_contra! hz
    apply hp
    apply Subtype.ext
    apply hnd.1
    intro m
    have hm : m ∈ P ⊔ Q := by rw [hc.sup_eq_top]; trivial
    obtain ⟨p', hp', q, hq, rfl⟩ := (LieSubmodule.mem_sup P Q m).mp hm
    have hp0 := hPP p ⟨p', hp'⟩
    have hq0 := hz ⟨q, hq⟩
    simp only [map_add, hp0, hq0, add_zero]
  obtain ⟨q, hq⟩ := hcross
  have h := hD p q
  rw [hP, hQ] at h
  simp only [map_smul, LinearMap.smul_apply, smul_eq_mul] at h
  have hsum : (c + a) * Φ p q = 0 := by linear_combination h
  have ha : a = -c := by
    have hca := (mul_eq_zero.mp hsum).resolve_right hq
    linear_combination hca
  refine ⟨c, ?_⟩
  ext m
  have hm : m ∈ P ⊔ Q := by rw [hc.sup_eq_top]; trivial
  obtain ⟨p', hp', q', hq', rfl⟩ := (LieSubmodule.mem_sup P Q m).mp hm
  have hpD := hP ⟨p', hp'⟩
  have hqD := hQ ⟨q', hq'⟩
  have hpS := pair_sign_left P Q hc ⟨p', hp'⟩
  have hqS := pair_sign_right P Q hc ⟨q', hq'⟩
  change D (p' + q') = c • dualPairSign P Q hc (p' + q')
  simp only [map_add, hpD, hqD, hpS, hqS, ha, smul_add, smul_neg, neg_smul]

end Pair

/-- Actual equivariant inclusion and projection maps for three summands.
Only the three retractions and the decomposition of every ambient vector
are recorded; cross-projector identities will follow from irreducibility. -/
structure ThreeBlockDecomposition (K L M U V N : Type*)
    [Field K] [LieRing L] [LieAlgebra K L]
    [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
    [AddCommGroup U] [Module K U] [LieRingModule L U] [LieModule K L U]
    [AddCommGroup V] [Module K V] [LieRingModule L V] [LieModule K L V]
    [AddCommGroup N] [Module K N] [LieRingModule L N] [LieModule K L N] where
  iU : U →ₗ⁅K,L⁆ M
  pU : M →ₗ⁅K,L⁆ U
  iV : V →ₗ⁅K,L⁆ M
  pV : M →ₗ⁅K,L⁆ V
  iQ : N →ₗ⁅K,L⁆ M
  pQ : M →ₗ⁅K,L⁆ N
  u_retraction : pU.comp iU = LieModuleHom.id
  v_retraction : pV.comp iV = LieModuleHom.id
  q_retraction : pQ.comp iQ = LieModuleHom.id
  sum_apply : ∀ m, iU (pU m) + iV (pV m) + iQ (pQ m) = m

section FormHelpers

variable {K L M S T : Type*} [Field K] [LieRing L] [LieAlgebra K L]
  [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  [AddCommGroup S] [Module K S] [LieRingModule L S] [LieModule K L S]
  [AddCommGroup T] [Module K T] [LieRingModule L T] [LieModule K L T]

private def invariantPairingMap
    (Φ : LinearMap.BilinForm K M) (hi : Φ.lieInvariant L)
    (i : S →ₗ⁅K,L⁆ M) (j : T →ₗ⁅K,L⁆ M) : S →ₗ⁅K,L⁆ Module.Dual K T where
  __ := Φ.compl₁₂ i.toLinearMap j.toLinearMap
  map_lie' := by
    intro x s
    ext t
    change Φ (i ⁅x, s⁆) (j t) = -Φ (i s) (j ⁅x, t⁆)
    rw [i.map_lie, j.map_lie]
    exact hi x (i s) (j t)

omit [LieModule K L M] [LieModule K L S] in
private theorem invariant_pairing_eq_zero_of_hom_zero
    (Φ : LinearMap.BilinForm K M) (hi : Φ.lieInvariant L)
    (i : S →ₗ⁅K,L⁆ M) (j : T →ₗ⁅K,L⁆ M)
    (d : T ≃ₗ⁅K,L⁆ Module.Dual K T)
    (hz : ∀ f : S →ₗ⁅K,L⁆ T, f = 0) (s : S) (t : T) : Φ (i s) (j t) = 0 := by
  have h := hz (d.symm.toLieModuleHom.comp (invariantPairingMap Φ hi i j))
  have hh := congrArg (fun F : S →ₗ⁅K,L⁆ T => d (F s) t) h
  change d (d.symm ((invariantPairingMap Φ hi i j) s)) t = d 0 t at hh
  rw [d.apply_symm_apply, map_zero] at hh
  exact hh

omit [LieAlgebra K L] [LieModule K L M] [LieModule K L S] in
private theorem pullback_nondegenerate_of_retraction
    (Φ : LinearMap.BilinForm K M) (hnd : Φ.Nondegenerate)
    (i : S →ₗ⁅K,L⁆ M) (p : M →ₗ⁅K,L⁆ S)
    (hr : p.comp i = LieModuleHom.id)
    (hl : ∀ s m, Φ (i s) m = Φ (i s) (i (p m)))
    (hrr : ∀ s m, Φ m (i s) = Φ (i (p m)) (i s)) :
    (Φ.compl₁₂ i.toLinearMap i.toLinearMap).Nondegenerate := by
  have hret (s : S) : p (i s) = s := congrArg (fun F : S →ₗ⁅K,L⁆ S => F s) hr
  constructor
  · intro s hs
    have hz : i s = 0 := hnd.1 _ (fun m => (hl s m).trans (hs (p m)))
    have hh := congrArg p hz
    simpa only [hret, map_zero] using hh
  · intro s hs
    have hz : i s = 0 := hnd.2 _ (fun m => (hrr s m).trans (hs (p m)))
    have hh := congrArg p hz
    simpa only [hret, map_zero] using hh

private theorem irreducible_skew_end_eq_zero [CharZero K] [IsAlgClosed K]
    [Module.Finite K S] [LieModule.IsIrreducible K L S]
    (Φ : LinearMap.BilinForm K S) (hnd : Φ.Nondegenerate)
    (D : S →ₗ⁅K,L⁆ S) (hD : ∀ x y, Φ (D x) y = -Φ x (D y)) : D = 0 := by
  obtain ⟨c, hc⟩ := equivariant_end_eq_smul_id D
  letI : Nontrivial S := LieModule.nontrivial_of_isIrreducible K L S
  obtain ⟨s, hs⟩ := exists_ne (0 : S)
  have hn : ∃ t : S, Φ s t ≠ 0 := by
    by_contra! hz
    exact hs (hnd.1 s hz)
  obtain ⟨t, ht⟩ := hn
  have h := hD s t
  rw [hc] at h
  simp only [LieModuleHom.smul_apply, LieModuleHom.id_apply,
    map_smul, LinearMap.smul_apply, smul_eq_mul] at h
  have htwo : (2 : K) * c * Φ s t = 0 := by linear_combination h
  have hc0 : c = 0 := (mul_eq_zero.mp ((mul_eq_zero.mp htwo).resolve_right ht)).resolve_left
    (by norm_num)
  rw [hc, hc0, zero_smul]

end FormHelpers

section ThreeBlocks

variable {K L M U V N : Type*} [Field K] [CharZero K] [IsAlgClosed K]
  [LieRing L] [LieAlgebra K L]
  [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
  [AddCommGroup U] [Module K U] [LieRingModule L U] [LieModule K L U]
  [AddCommGroup V] [Module K V] [LieRingModule L V] [LieModule K L V]
  [AddCommGroup N] [Module K N] [LieRingModule L N] [LieModule K L N]
  [Module.Finite K U] [Module.Finite K V] [Module.Finite K N]
  [LieModule.IsIrreducible K L U] [LieModule.IsIrreducible K L V]

set_option maxHeartbeats 800000 in
/-- Two inequivalent self-dual irreducibles and one inequivalent
irreducible dual pair have precisely a nonzero line of equivariant skew
endomorphisms for every invariant nondegenerate symmetric form. -/
theorem three_block_trace_skew_line
    (A : ThreeBlockDecomposition K L M U V N)
    (hsU : Nonempty (U ≃ₗ⁅K,L⁆ Module.Dual K U))
    (hsV : Nonempty (V ≃ₗ⁅K,L⁆ Module.Dual K V))
    (hneUV : ¬ Nonempty (U ≃ₗ⁅K,L⁆ V))
    (P Q : LieSubmodule K L N) (hc : IsCompl P Q)
    [LieModule.IsIrreducible K L P] [LieModule.IsIrreducible K L Q]
    (d : Q ≃ₗ⁅K,L⁆ Module.Dual K P) (hne : ¬Nonempty (P ≃ₗ⁅K,L⁆ Q))
    (Φ : LinearMap.BilinForm K M) (hi : Φ.lieInvariant L)
    (hsym : LinearMap.IsSymm Φ) (hnd : Φ.Nondegenerate) :
    ∃ D₀ : M →ₗ⁅K,L⁆ M, D₀ ≠ 0 ∧
      (∀ x y, Φ (D₀ x) y = -Φ x (D₀ y)) ∧
      ∀ D : M →ₗ⁅K,L⁆ M, (∀ x y, Φ (D x) y = -Φ x (D y)) →
        ∃ c : K, D = c • D₀ := by
  obtain ⟨dU⟩ := hsU
  obtain ⟨dV⟩ := hsV
  have hUV : ∀ f : U →ₗ⁅K,L⁆ V, f = 0 :=
    irreducible_hom_eq_zero_of_not_equiv hneUV
  have hVU : ∀ f : V →ₗ⁅K,L⁆ U, f = 0 :=
    irreducible_hom_eq_zero_of_not_equiv (by rintro ⟨e⟩; exact hneUV ⟨e.symm⟩)
  have hUN : ∀ f : U →ₗ⁅K,L⁆ N, f = 0 :=
    self_dual_irreducible_pair_hom_eq_zero P Q hc d hne ⟨dU⟩
  have hVN : ∀ f : V →ₗ⁅K,L⁆ N, f = 0 :=
    self_dual_irreducible_pair_hom_eq_zero P Q hc d hne ⟨dV⟩
  have hNU : ∀ f : N →ₗ⁅K,L⁆ U, f = 0 :=
    dual_pair_hom_to_self_dual_eq_zero P Q hc d hne ⟨dU⟩
  have hNV : ∀ f : N →ₗ⁅K,L⁆ V, f = 0 :=
    dual_pair_hom_to_self_dual_eq_zero P Q hc d hne ⟨dV⟩
  have huv : ∀ u v, Φ (A.iU u) (A.iV v) = 0 :=
    invariant_pairing_eq_zero_of_hom_zero Φ hi A.iU A.iV dV hUV
  have hnu : ∀ n u, Φ (A.iQ n) (A.iU u) = 0 :=
    invariant_pairing_eq_zero_of_hom_zero Φ hi A.iQ A.iU dU hNU
  have hnv : ∀ n v, Φ (A.iQ n) (A.iV v) = 0 :=
    invariant_pairing_eq_zero_of_hom_zero Φ hi A.iQ A.iV dV hNV
  have hvu : ∀ v u, Φ (A.iV v) (A.iU u) = 0 :=
    fun v u => (hsym.eq _ _).trans (huv u v)
  have hun : ∀ u n, Φ (A.iU u) (A.iQ n) = 0 :=
    fun u n => (hsym.eq _ _).trans (hnu n u)
  have hvn : ∀ v n, Φ (A.iV v) (A.iQ n) = 0 :=
    fun v n => (hsym.eq _ _).trans (hnv n v)
  have hfirstU : ∀ u m, Φ (A.iU u) m = Φ (A.iU u) (A.iU (A.pU m)) := by
    intro u m
    calc
      Φ (A.iU u) m = Φ (A.iU u) (A.iU (A.pU m) + A.iV (A.pV m) + A.iQ (A.pQ m)) :=
        congrArg (Φ (A.iU u)) (A.sum_apply m).symm
      _ = _ := by rw [map_add, map_add, huv, hun, add_zero, add_zero]
  have hfirstV : ∀ v m, Φ (A.iV v) m = Φ (A.iV v) (A.iV (A.pV m)) := by
    intro v m
    calc
      Φ (A.iV v) m = Φ (A.iV v) (A.iU (A.pU m) + A.iV (A.pV m) + A.iQ (A.pQ m)) :=
        congrArg (Φ (A.iV v)) (A.sum_apply m).symm
      _ = _ := by rw [map_add, map_add, hvu, hvn, zero_add, add_zero]
  have hfirstN : ∀ n m, Φ (A.iQ n) m = Φ (A.iQ n) (A.iQ (A.pQ m)) := by
    intro n m
    calc
      Φ (A.iQ n) m = Φ (A.iQ n) (A.iU (A.pU m) + A.iV (A.pV m) + A.iQ (A.pQ m)) :=
        congrArg (Φ (A.iQ n)) (A.sum_apply m).symm
      _ = _ := by rw [map_add, map_add, hnu, hnv, zero_add, zero_add]
  have hsecondU : ∀ u m, Φ m (A.iU u) = Φ (A.iU (A.pU m)) (A.iU u) :=
    fun u m => (hsym.eq _ _).trans ((hfirstU u m).trans (hsym.eq _ _))
  have hsecondV : ∀ v m, Φ m (A.iV v) = Φ (A.iV (A.pV m)) (A.iV v) :=
    fun v m => (hsym.eq _ _).trans ((hfirstV v m).trans (hsym.eq _ _))
  have hsecondN : ∀ n m, Φ m (A.iQ n) = Φ (A.iQ (A.pQ m)) (A.iQ n) :=
    fun n m => (hsym.eq _ _).trans ((hfirstN n m).trans (hsym.eq _ _))
  let ΨU : LinearMap.BilinForm K U := Φ.compl₁₂ A.iU.toLinearMap A.iU.toLinearMap
  let ΨV : LinearMap.BilinForm K V := Φ.compl₁₂ A.iV.toLinearMap A.iV.toLinearMap
  let ΨN : LinearMap.BilinForm K N := Φ.compl₁₂ A.iQ.toLinearMap A.iQ.toLinearMap
  have hU : ΨU.Nondegenerate :=
    pullback_nondegenerate_of_retraction Φ hnd A.iU A.pU A.u_retraction hfirstU hsecondU
  have hV : ΨV.Nondegenerate :=
    pullback_nondegenerate_of_retraction Φ hnd A.iV A.pV A.v_retraction hfirstV hsecondV
  have hN : ΨN.Nondegenerate :=
    pullback_nondegenerate_of_retraction Φ hnd A.iQ A.pQ A.q_retraction hfirstN hsecondN
  have hiN : ΨN.lieInvariant L := by
    intro x n n'
    change Φ (A.iQ ⁅x, n⁆) (A.iQ n') = -Φ (A.iQ n) (A.iQ ⁅x, n'⁆)
    rw [A.iQ.map_lie, A.iQ.map_lie]
    exact hi x (A.iQ n) (A.iQ n')
  let D₀ := A.iQ.comp ((dualPairSign P Q hc).comp A.pQ)
  have hretQ (n : N) : A.pQ (A.iQ n) = n :=
    congrArg (fun F : N →ₗ⁅K,L⁆ N => F n) A.q_retraction
  refine ⟨D₀, ?_, ?_, ?_⟩
  · intro hz
    letI : Nontrivial P := LieModule.nontrivial_of_isIrreducible K L P
    apply dual_pair_sign_ne_zero P Q hc
    ext n
    have hh := congrArg (fun F : M →ₗ⁅K,L⁆ M => A.pQ (F (A.iQ n))) hz
    change A.pQ (A.iQ (dualPairSign P Q hc (A.pQ (A.iQ n)))) = A.pQ 0 at hh
    simpa only [hretQ, map_zero] using hh
  · intro x y
    change Φ (A.iQ (dualPairSign P Q hc (A.pQ x))) y =
