    rw [hfirstN]
    conv_rhs => rw [hsecondN]
    have hns := inequivalent_dual_pair_not_self_dual d hne
    exact dual_pair_sign_skew P Q hc hns.1 hns.2 ΨN hiN (A.pQ x) (A.pQ y)
  · intro D hD
    let DU := A.pU.comp (D.comp A.iU)
    let DV := A.pV.comp (D.comp A.iV)
    let DN := A.pQ.comp (D.comp A.iQ)
    have hu (u : U) : D (A.iU u) = A.iU (DU u) := by
      have hv : A.pV (D (A.iU u)) = 0 :=
        congrArg (fun F : U →ₗ⁅K,L⁆ V => F u) (hUV (A.pV.comp (D.comp A.iU)))
      have hn : A.pQ (D (A.iU u)) = 0 :=
        congrArg (fun F : U →ₗ⁅K,L⁆ N => F u) (hUN (A.pQ.comp (D.comp A.iU)))
      have hh := A.sum_apply (D (A.iU u))
      rw [hv, hn, map_zero, map_zero, add_zero, add_zero] at hh
