    have hv (v : V) : D (A.iV v) = A.iV (DV v) := by
      have hu : A.pU (D (A.iV v)) = 0 :=
        congrArg (fun F : V →ₗ⁅K,L⁆ U => F v) (hVU (A.pU.comp (D.comp A.iV)))
      have hn : A.pQ (D (A.iV v)) = 0 :=
        congrArg (fun F : V →ₗ⁅K,L⁆ N => F v) (hVN (A.pQ.comp (D.comp A.iV)))
      have hh := A.sum_apply (D (A.iV v))
      rw [hu, hn, map_zero, map_zero, zero_add, add_zero] at hh
      exact hh.symm
    have hn (n : N) : D (A.iQ n) = A.iQ (DN n) := by
      have hu : A.pU (D (A.iQ n)) = 0 :=
        congrArg (fun F : N →ₗ⁅K,L⁆ U => F n) (hNU (A.pU.comp (D.comp A.iQ)))
      have hv : A.pV (D (A.iQ n)) = 0 :=
        congrArg (fun F : N →ₗ⁅K,L⁆ V => F n) (hNV (A.pV.comp (D.comp A.iQ)))
      have hh := A.sum_apply (D (A.iQ n))
      rw [hu, hv, map_zero, map_zero, zero_add, zero_add] at hh
      exact hh.symm
    have hDU : DU = 0 := by
      apply irreducible_skew_end_eq_zero ΨU hU DU
      intro u u'
      change Φ (A.iU (DU u)) (A.iU u') = -Φ (A.iU u) (A.iU (DU u'))
      rw [← hu, ← hu]
      exact hD (A.iU u) (A.iU u')
    have hDV : DV = 0 := by
      apply irreducible_skew_end_eq_zero ΨV hV DV
      intro v v'
      change Φ (A.iV (DV v)) (A.iV v') = -Φ (A.iV v) (A.iV (DV v'))
      rw [← hv, ← hv]
      exact hD (A.iV v) (A.iV v')
    have hDN : ∀ n n', ΨN (DN n) n' = -ΨN n (DN n') := by
      intro n n'
      change Φ (A.iQ (DN n)) (A.iQ n') = -Φ (A.iQ n) (A.iQ (DN n'))
      rw [← hn, ← hn]
      exact hD (A.iQ n) (A.iQ n')
    obtain ⟨c, hDN'⟩ := dual_pair_skew_end_eq_smul_sign P Q hc d hne ΨN hiN hN DN hDN
    refine ⟨c, ?_⟩
    ext m
    have hh := congrArg D (A.sum_apply m)
    rw [map_add, map_add, hu, hv, hn, hDU, hDV,
      LieModuleHom.zero_apply, LieModuleHom.zero_apply, map_zero, map_zero,
