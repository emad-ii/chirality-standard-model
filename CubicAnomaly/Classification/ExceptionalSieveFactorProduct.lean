import CubicAnomaly.Classification.ExceptionalSieveFactorIndex
import CubicAnomaly.Classification.IdealProductRepresentation
import Mathlib.RingTheory.MatrixAlgebra
import Mathlib.RingTheory.SimpleRing.Matrix

/-!
# Product of the dimensions of the actual simple-factor constituents

Each atomic ideal acts through a full matrix algebra on its irreducible
constituent. Inside the operators of the full module these matrix algebras
commute. Joining another matrix factor tensors the previous simple algebra
with that matrix algebra: the tensor is again a matrix ring, so its unital
action is injective. Density identifies the join over all ideals with the
entire endomorphism algebra.
-/

namespace CubicAnomaly.Classification.ExceptionalSieveFactorProduct

open LieAlgebra LieModule Module
open TensorEvaluation IdealProductRepresentation
open scoped TensorProduct

private theorem simple_of_equiv {A B : Type*} [Ring A] [Ring B] [IsSimpleRing A]
    (e : A ≃+* B) : IsSimpleRing B := by
  letI : Nontrivial B := e.injective.nontrivial
  apply (IsSimpleRing.iff_injective_ringHom B).mpr
  intro S _ _ f
  have hi := (f.comp e.toRingHom).injective
  intro x y hxy
  obtain ⟨x, rfl⟩ := e.surjective x
  obtain ⟨y, rfl⟩ := e.surjective y
  exact congrArg e (hi hxy)

variable {E : Type*} [Ring E] [Algebra ℂ E] [FiniteDimensional ℂ E] [Nontrivial E]

private theorem join_matrix_factor (A B : Subalgebra ℂ E) [IsSimpleRing A]
    (n : ℕ) [NeZero n] (f : Matrix (Fin n) (Fin n) ℂ ≃ₐ[ℂ] B)
    (hc : ∀ (x : A) (y : B), Commute (x : E) (y : E)) :
    IsSimpleRing ↥(A ⊔ B) ∧ finrank ℂ ↥(A ⊔ B) = finrank ℂ A * n^2 := by
  classical
  let F : A ⊗[ℂ] (Matrix (Fin n) (Fin n) ℂ) →ₐ[ℂ] E :=
    Algebra.TensorProduct.lift A.val (B.val.comp f.toAlgHom) (fun x y => hc x (f y))
  letI : IsSimpleRing (A ⊗[ℂ] (Matrix (Fin n) (Fin n) ℂ)) := simple_of_equiv
    (matrixEquivTensor (Fin n) ℂ A).toRingEquiv
  have hrange : F.range = A ⊔ B := by
    apply le_antisymm
    · rintro x ⟨z,rfl⟩
      change F z ∈ A ⊔ B
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul x y => exact (A ⊔ B).mul_mem ((show A ≤ A ⊔ B from le_sup_left) x.property) ((show B ≤ A ⊔ B from le_sup_right) (f y).property)
      | add z z' hz hz' => change F (z + z') ∈ _; rw [map_add]; exact (A ⊔ B).add_mem hz hz'
    · apply sup_le
      · intro x hx
        exact ⟨(⟨x,hx⟩ : A) ⊗ₜ[ℂ] (1 : (Matrix (Fin n) (Fin n) ℂ)), by simp [F]⟩
      · intro y hy
        exact ⟨(1 : A) ⊗ₜ[ℂ] f.symm ⟨y,hy⟩, by change (1 : E) * ((f (f.symm ⟨y,hy⟩) : B) : E) = y; rw [one_mul, AlgEquiv.apply_symm_apply]⟩
  have eqv := AlgEquiv.ofInjective F F.toRingHom.injective
  rw [← hrange]
  refine ⟨simple_of_equiv eqv.toRingEquiv, ?_⟩
  rw [← eqv.toLinearEquiv.finrank_eq, Module.finrank_tensorProduct]
  simp [Module.finrank_matrix, pow_two]

/-- A finite join of pairwise commuting full matrix algebras inside a
common operator ring has dimension the square of the product of their degrees. -/
theorem matrix_join_dimension {T ι : Type*} [Ring T] [Algebra ℂ T] [FiniteDimensional ℂ T]
    [Nontrivial T] (A : ι → Subalgebra ℂ T) (d : ι → ℕ) (hd : ∀ i, 0 < d i)
    (hm : ∀ i, Nonempty (Matrix (Fin (d i)) (Fin (d i)) ℂ ≃ₐ[ℂ] A i))
    (hcomm : ∀ i j, i ≠ j → ∀ (x : A i) (y : A j), Commute (x : T) (y : T))
    (s : Finset ι) : IsSimpleRing ↥(s.sup A) ∧ finrank ℂ ↥(s.sup A) = (∏ i ∈ s, d i)^2 := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.prod_empty, one_pow]
    let E := Algebra.botEquiv ℂ T
    exact ⟨simple_of_equiv E.symm.toRingEquiv, E.toLinearEquiv.finrank_eq.trans (finrank_self ℂ)⟩
  | @insert i s hi ih =>
    letI := ih.1
    letI : NeZero (d i) := ⟨(hd i).ne'⟩
    obtain ⟨f⟩ := hm i
    have hcentral : s.sup A ≤ Subalgebra.centralizer ℂ (A i) := by
      apply Finset.sup_le
      intro j hj x hx
      apply (Subalgebra.mem_centralizer_iff ℂ).mpr
      intro y hy
      exact hcomm i j (fun e => hi (e ▸ hj)) ⟨y,hy⟩ ⟨x,hx⟩
    have hh := join_matrix_factor (s.sup A) (A i) (d i) f (fun x y =>
      ((Subalgebra.mem_centralizer_iff ℂ).mp (hcentral x.property) y y.property).symm)
    rw [Finset.sup_insert, sup_comm, Finset.prod_insert hi, mul_pow, mul_comm ((d i)^2), ← ih.2]
    exact hh

/-- The subalgebra generated by the action of an individual Lie ideal. -/
def idealActionAlgebra {L W : Type*} [LieRing L] [LieAlgebra ℂ L] [AddCommGroup W]
    [Module ℂ W] [LieRingModule L W] [LieModule ℂ L W] (I : LieIdeal ℂ L) :
    Subalgebra ℂ (Module.End ℂ W) := Algebra.adjoin ℂ (Set.range (toEnd ℂ I W))

variable {L W : Type*} [LieRing L] [LieAlgebra ℂ L] [AddCommGroup W]
  [Module ℂ W] [LieRingModule L W] [LieModule ℂ L W] [FiniteDimensional ℂ W]

/-- Operators of one irreducible constituent lift to the whole isotypic
module and carry each Lie generator to its action on that module. -/
theorem isotypic_operator_lift (I : LieIdeal ℂ L) (S : LieSubmodule ℂ I W)
    [IsIrreducible ℂ I S] [Nontrivial W]
    (hb : Function.Bijective (lieHomEvaluation (K := ℂ) (L := I) (U := S) (W := W))) :
    ∃ F : Module.End ℂ S →ₐ[ℂ] Module.End ℂ W, Function.Injective F ∧
      ∀ x : I, F (toEnd ℂ I S x) = toEnd ℂ I W x := by
  classical
  let D := S →ₗ⁅ℂ,I⁆ W
  let E := LinearEquiv.ofBijective lieHomEvaluation hb
  let F : Module.End ℂ S →ₐ[ℂ] Module.End ℂ W :=
    (E.conjAlgEquiv (R := ℂ)).toAlgHom.comp (Module.End.rTensorAlgHom ℂ S D)
  have hf (x : I) : F (toEnd ℂ I S x) = toEnd ℂ I W x := by
    ext w
    obtain ⟨p, rfl⟩ := E.surjective w
    have h := LinearMap.congr_fun (lieHomEvaluation_comp_left_action (U := S) (W := W) x) p
    simpa [F, E] using h
  letI := nontrivial_of_isIrreducible ℂ I S
  letI : NeZero (finrank ℂ S) := ⟨finrank_pos.ne'⟩
  letI : IsSimpleRing (Module.End ℂ S) := simple_of_equiv
    (LinearMap.toMatrixAlgEquiv (Module.finBasis ℂ S)).symm.toRingEquiv
  exact ⟨F, F.toRingHom.injective, hf⟩

/-- For any actual constituent with bijective evaluation the ideal action
algebra is the full matrix algebra of the constituent dimension. -/
theorem ideal_action_matrix (I : LieIdeal ℂ L) (S : LieSubmodule ℂ I W)
    [IsIrreducible ℂ I S] [Nontrivial W]
    (hb : Function.Bijective (lieHomEvaluation (K := ℂ) (L := I) (U := S) (W := W))) :
    Nonempty (Matrix (Fin (finrank ℂ S)) (Fin (finrank ℂ S)) ℂ ≃ₐ[ℂ]
      idealActionAlgebra (W := W) I) := by
  classical
  obtain ⟨F,hF,hf⟩ := isotypic_operator_lift I S hb
  have hrange : F.range = idealActionAlgebra (W := W) I := by
    rw [← Algebra.map_top, ← LieDensity.lie_action_adjoin_eq_top (L := I) (M := S),
      AlgHom.map_adjoin, ← Set.range_comp, idealActionAlgebra]
    exact congrArg (Algebra.adjoin ℂ) (congrArg Set.range (funext hf))
  rw [← hrange]
  exact ⟨(LinearMap.toMatrixAlgEquiv (Module.finBasis ℂ S)).symm.trans (AlgEquiv.ofInjective F hF)⟩

omit [FiniteDimensional ℂ W] in
private theorem commute_actions (I J : LieIdeal ℂ L) (hIJ : Disjoint I J)
    (x : idealActionAlgebra (W := W) I) (y : idealActionAlgebra (W := W) J) :
    Commute (x : Module.End ℂ W) (y : Module.End ℂ W) := by
  apply Algebra.commute_of_mem_adjoin_of_forall_mem_commute y.property
  rintro _ ⟨z,rfl⟩
  apply Commute.symm
  apply Algebra.commute_of_mem_adjoin_of_forall_mem_commute x.property
  rintro _ ⟨v,rfl⟩
  change Commute (toEnd ℂ L W (z : L)) (toEnd ℂ L W (v : L))
  rw [commute_iff_lie_eq, ← LieHom.map_lie, disjoint_ideals_bracket_zero J I hIJ.symm z v, map_zero]

variable [IsIrreducible ℂ L W]

/-- If pairwise disjoint ideals span the algebra, the dimensions of their
actual irreducible matrix actions multiply to the dimension of the full
module. This holds for every choice of irreducible isotypic constituent. -/
theorem dimension_product_of_ideal_actions {ι : Type*} [Fintype ι] (I : ι → LieIdeal ℂ L)
    (hdis : Pairwise (fun i j => Disjoint (I i) (I j))) (hspan : ⨆ i, I i = ⊤)
    (S : ∀ i, LieSubmodule ℂ (I i) W) (hS : ∀ i, IsIrreducible ℂ (I i) (S i))
    (hb : ∀ i, Function.Bijective (lieHomEvaluation (K := ℂ) (L := I i) (U := S i) (W := W))) :
    finrank ℂ W = ∏ i, finrank ℂ (S i) := by
  classical
  letI := nontrivial_of_isIrreducible ℂ L W
  letI (i : ι) := hS i
  let A i := idealActionAlgebra (W := W) (I i)
  let d i := finrank ℂ (S i)
  have hd (i : ι) : 0 < d i := by
    letI := nontrivial_of_isIrreducible ℂ (I i) (S i)
    exact finrank_pos
  have aux := matrix_join_dimension A d hd (fun i => ideal_action_matrix (I i) (S i) (hb i))
    (fun i j hij => commute_actions (I i) (I j) (hdis hij))
  have hfull : Finset.univ.sup A = ⊤ := by
    apply LieDensity.subalgebra_eq_top_of_lie_action_mem (L := L)
    intro x
    have hx : x ∈ ⨆ i, I i := hspan ▸ LieSubmodule.mem_top _
    refine LieSubmodule.iSup_induction I (motive := fun y => toEnd ℂ L W y ∈ Finset.univ.sup A) hx ?_ ?_ ?_
    · intro i y hy
      apply (Finset.le_sup (f := A) (Finset.mem_univ i))
      exact Algebra.subset_adjoin (Set.mem_range_self (⟨y,hy⟩ : I i))
    · simp
    · intro x y hx hy
      rw [map_add]
      exact (Finset.univ.sup A).add_mem hx hy
  have he := (aux Finset.univ).2
  rw [hfull] at he
  have htop := (Subalgebra.topEquiv (R := ℂ) (A := Module.End ℂ W)).toLinearEquiv.finrank_eq
  rw [htop, Module.finrank_linearMap] at he
  change finrank ℂ W * finrank ℂ W = (∏ i, d i)^2 at he
  exact Nat.pow_left_injective (by decide : 2 ≠ 0) (by simpa only [sq] using he)

section Semisimple

variable [LieAlgebra.IsSemisimple ℂ L] [FiniteDimensional ℂ L]

variable (L) in
abbrev Atom := {I : LieIdeal ℂ L // IsAtom I}

omit [FiniteDimensional ℂ L] in
private theorem atom_independent : iSupIndep fun i : Atom L => i.val.toSubmodule :=
  LieSubmodule.iSupIndep_toSubmodule.mpr ((sSupIndep_iff _).mp IsSemisimple.sSupIndep_isAtom)

variable (L) in
/-- The actual atomic ideals form a finite index type because their nonzero
underlying subspaces are independent. -/
noncomputable def atomFintype : Fintype (Atom L) := by
  classical
  letI := (atom_independent (L := L)).fintypeNeBotOfFiniteDimensional
  let f (i : Atom L) : {j : Atom L // j.val.toSubmodule ≠ ⊥} :=
    ⟨i, fun h => i.property.ne_bot ((LieSubmodule.toSubmodule_eq_bot i.val).mp h)⟩
  exact Fintype.ofInjective f (fun _ _ h => congrArg Subtype.val h)

omit [FiniteDimensional ℂ L] in
theorem atom_span : ⨆ i : Atom L, i.val = ⊤ :=
  (sSup_eq_iSup' {I : LieIdeal ℂ L | IsAtom I}).symm.trans IsSemisimple.sSup_atoms_eq_top

/-- For arbitrary atomic constituents chosen on *each* atomic ideal, all the
constituent dimensions multiply to the full module dimension. -/
theorem all_atomic_constituent_dimension_product
    (S : ∀ i : Atom L, LieSubmodule ℂ i.val W) (ha : ∀ i, IsAtom (S i)) :
    letI := atomFintype L
    finrank ℂ W = ∏ i : Atom L, finrank ℂ (S i) := by
  letI := atomFintype L
  have hi (i : Atom L) : IsIrreducible ℂ i.val (S i) := atomic_lieSubmodule_irreducible (S i) (ha i)
  apply dimension_product_of_ideal_actions (fun i : Atom L => i.val)
    ((sSupIndep_iff _).mp IsSemisimple.sSupIndep_isAtom).pairwiseDisjoint atom_span S hi
  intro i
  letI := hi i
  refine ⟨lieHomEvaluation_injective, commutingIdeal_lieHomEvaluation_surjective i.val i.valᶜ
    disjoint_compl_right sup_compl_eq_top ?_⟩
  refine ⟨(S i).incl, ?_⟩
  intro hzero
  apply (ha i).ne_bot
  apply (LieSubmodule.eq_bot_iff _).mpr
  intro y hy
  exact LieModuleHom.congr_fun hzero ⟨y, hy⟩

private theorem atom_sum_equiv :
    letI := atomFintype L
    ∃ E : ((i : Atom L) → i.val) ≃ₗ[ℂ] L,
      ∀ f : (i : Atom L) → i.val, E f = ∑ i : Atom L, ((f i : i.val) : L) := by
  classical
  letI := atomFintype L
  let A (i : Atom L) := i.val.toSubmodule
  let P := DirectSum.linearEquivFunOnFintype ℂ (Atom L) (fun i => ↥(A i))
  have hr : (DirectSum.coeLinearMap A).range = ⊤ := by
    rw [DirectSum.range_coeLinearMap]
    change (⨆ i : Atom L, i.val.toSubmodule) = ⊤
    rw [← LieSubmodule.iSup_toSubmodule]
    change (⨆ i : Atom L, i.val).toSubmodule = ⊤
    rw [atom_span, LieSubmodule.top_toSubmodule]
  let G := LinearEquiv.ofBijective (DirectSum.coeLinearMap A)
    ⟨atom_independent.dfinsupp_lsum_injective, LinearMap.range_eq_top.mp hr⟩
  let E := P.symm.trans G
  refine ⟨E, fun f => ?_⟩
  have hs : f = ∑ i, Pi.single i (f i) := by
    funext i
    simp [Finset.sum_apply]
  have hsingle (i : Atom L) : E (Pi.single i (f i)) = (f i : L) := by
    change (DirectSum.coeLinearMap A) (P.symm (Pi.single i (f i))) = _
    rw [show P.symm (Pi.single i (f i)) = DirectSum.lof ℂ _ _ i (f i) from
      DirectSum.linearEquivFunOnFintype_symm_single ..]
    exact DirectSum.coeLinearMap_of A i _
  calc
    E f = E (∑ i, Pi.single i (f i)) := congrArg E hs
    _ = _ := by rw [map_sum]; exact Finset.sum_congr rfl fun i _ => hsingle i

open LieAlgebra.IsKilling

/-- Both the algebra and its Cartan split dimension by dimension over
the actual atomic ideals. Each factor Cartan here is the literal inverse
image of the ambient Cartan along the ideal inclusion. -/
theorem atomic_dimension_and_rank_sums [LieAlgebra.IsKilling ℂ L] (H : LieSubalgebra ℂ L)
    [H.IsCartanSubalgebra] :
    letI := atomFintype L
    finrank ℂ L = ∑ i : Atom L, finrank ℂ i.val ∧
    finrank ℂ H = ∑ i : Atom L, finrank ℂ (H.comap i.val.toLieSubalgebra.incl) := by
  classical
  letI := atomFintype L
  obtain ⟨E, hE⟩ := atom_sum_equiv (L := L)
  refine ⟨E.finrank_eq.symm.trans (Module.finrank_pi_fintype ℂ), ?_⟩
  let C (i : Atom L) : LieSubalgebra ℂ i.val := H.comap i.val.toLieSubalgebra.incl
  let f : ((i : Atom L) → C i) →ₗ[ℂ] H := {
    toFun := fun z => ⟨∑ i, ((z i).val.val : L), H.sum_mem (fun i _ => (z i).property)⟩
    map_add' := fun x y => Subtype.ext (Finset.sum_add_distrib ..)
    map_smul' := fun a x => Subtype.ext (Finset.smul_sum ..).symm }
  have hf (z : (i : Atom L) → C i) : (f z : L) = E (fun i => (z i).val) := (hE _).symm
  have hbij : Function.Bijective f := by
    constructor
    · intro z y he
      have he' := congrArg (fun v : H => (v : L)) he
      change (f z : L) = (f y : L) at he'
      rw [hf, hf] at he'
      exact funext fun i => Subtype.ext (congrFun (E.injective he') i)
    · intro x
      obtain ⟨z, hz⟩ := E.surjective (x : L)
      have hcen (t : H) (i : Atom L) : ⁅(t : L), (z i : L)⁆ = 0 := by
        have hsum : E (fun j => ⁅(t : L), z j⁆) = 0 := by
          rw [hE]
          change (∑ i, ⁅(t : L), (z i : L)⁆) = 0
          rw [← lie_sum, ← hE, hz]
          exact congrArg (fun v : H => (v : L)) (trivial_lie_zero H H t x)
        have hzero := E.injective (hsum.trans (map_zero E).symm)
        exact congrArg (fun v : i.val => (v : L)) (congrFun hzero i)
      have hmem (i : Atom L) : (z i : L) ∈ H := by
        rw [← show H.normalizer = H from LieSubalgebra.IsCartanSubalgebra.self_normalizing]
        apply (H.mem_normalizer_iff _).mpr
        intro t ht
        rw [← lie_skew, hcen ⟨t,ht⟩ i, neg_zero]
        exact H.zero_mem
      refine ⟨fun i => ⟨z i, hmem i⟩, Subtype.ext ?_⟩
      exact (hf _).trans hz
  exact (LinearEquiv.ofBijective f hbij).finrank_eq.symm.trans (Module.finrank_pi_fintype ℂ)

end Semisimple
end CubicAnomaly.Classification.ExceptionalSieveFactorProduct
