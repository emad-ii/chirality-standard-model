import CubicAnomaly.Classification.ExceptionalRoots
import Mathlib.LinearAlgebra.RootSystem.CartanMatrix
import Mathlib.Tactic

/-!
# Transport from actual simple roots to the exceptional census lists

In each of the five lists generated by the census, reflection in any simple
root stays in the list. Conversely every entry can be reduced to a signed
simple root by simple reflections that strictly decrease its coordinate
height. These finite facts certify that a reduced root system with the
specified simple Cartan matrix has exactly the roots on the census list.
-/

namespace CubicAnomaly.Classification.RootClassificationExceptional

open CubicAnomaly.Classification.Exceptional
open scoped BigOperators

/-- Index set of the simple coordinate directions in the authored matrix. -/
abbrev Index (d : RootDatum) := Fin d.cartan.size

/-- The generated census list expressed as fixed-length coordinate vectors. -/
def table (d : RootDatum) : Finset (Vector ℤ d.cartan.size) :=
  ((roots d).toList.map fun a => Vector.ofFn fun i : Index d => a[i.val]!).toFinset

/-- The authored Cartan matrix in the row-root, column-coroot convention. -/
def matrix (d : RootDatum) (i j : Index d) : ℤ := (d.cartan[i.val]!)[j.val]!

private def unit (d : RootDatum) (i : Index d) : Vector ℤ d.cartan.size :=
  Vector.ofFn (Pi.single i 1)

private def negate {n : ℕ} (x : Vector ℤ n) : Vector ℤ n := Vector.ofFn fun i => -x[i]

private def coefficient (d : RootDatum) (v : Vector ℤ d.cartan.size) (i : Index d) :=
  ∑ j, v[j] * matrix d j i

private def reflect (d : RootDatum) (v : Vector ℤ d.cartan.size) (i : Index d) :=
  Vector.ofFn fun j => v[j] - if j = i then coefficient d v i else 0

private def height {n : ℕ} (v : Vector ℤ n) : ℕ := ∑ i : Fin n, (v[i]).natAbs

/-- Length and uniqueness of the source arrays, closure, and a descent
witness for every nonsimple signed entry of the generated list. -/
def Certified (d : RootDatum) : Prop :=
  (∀ a ∈ (roots d).toList, a.size = d.cartan.size) ∧
  (table d).card = (roots d).size ∧
  (∀ i, unit d i ∈ table d) ∧
  (∀ v ∈ table d, negate v ∈ table d) ∧
  (∀ v ∈ table d, ∀ i, reflect d v i ∈ table d) ∧
  (∀ v ∈ table d, (∃ i, v = unit d i ∨ v = negate (unit d i)) ∨
    ∃ i, height (reflect d v i) < height v)

instance (d : RootDatum) : Decidable (Certified d) := by unfold Certified; infer_instance

/-- Closure and descent receipts for all five tables used by the census. -/
theorem exceptional_root_tables_certified :
    Certified g2Datum ∧ Certified f4Datum ∧ Certified e6Datum ∧
    Certified e7Datum ∧ Certified e8Datum := by
  native_decide

/-- The finite set of census roots in the specified character grade. -/
def gradeTable (d : RootDatum) (a : Index d → ZMod 3) (k : ZMod 3) :
    Finset (Vector ℤ d.cartan.size) :=
  (table d).filter fun v => ∑ i, (v.get i : ZMod 3) * a i = k

/-- The rectangular cubic contraction matrix evaluated on the census roots. -/
def censusCubicMatrix (d : RootDatum) (a : Index d → ZMod 3) (k : ZMod 3) :
    Matrix (Index d × Index d) (Index d) ℤ :=
  fun jk i => ∑ v : ↥(gradeTable d a k), v.val.get i * v.val.get jk.1 * v.val.get jk.2

section RootSystem

variable {K M N ι : Type*} [Field K] [CharZero K]
  [AddCommGroup M] [Module K M] [AddCommGroup N] [Module K N]
  {P : RootPairing ι K M N}
  (b : P.Base) {d : RootDatum} (s : Index d ≃ b.support)

/-- Interpret a census vector as the indicated integral combination of actual simple roots. -/
def realize (v : Vector ℤ d.cartan.size) : M := ∑ i, v[i] • P.root (s i)

omit [CharZero K] in
private theorem realize_unit (i : Index d) : realize b s (unit d i) = P.root (s i) := by
  simp [realize, unit, Pi.single_apply]

omit [CharZero K] in
private theorem realize_negate (v : Vector ℤ d.cartan.size) :
    realize b s (negate v) = -realize b s v := by
  simp [realize, negate, Finset.sum_neg_distrib]

variable [P.IsCrystallographic]

omit [CharZero K] in
private theorem realize_reflect
    (h : ∀ i j, b.cartanMatrix (s i) (s j) = matrix d i j)
    (v : Vector ℤ d.cartan.size) (i : Index d) :
    realize b s (reflect d v i) = P.reflection (s i) (realize b s v) := by
  have hcoef : P.coroot' (s i) (realize b s v) = (coefficient d v i : K) := by
    simp only [realize, map_sum, map_zsmul, RootPairing.root_coroot'_eq_pairing,
      coefficient, Int.cast_sum, Int.cast_mul, zsmul_eq_mul]
    apply Finset.sum_congr rfl
    intro j _
    rw [← h]
    congr 1
    exact (b.algebraMap_cartanMatrixIn_apply ℤ (s j) (s i)).symm
  rw [RootPairing.reflection_apply, hcoef]
  simp [realize, reflect, add_zsmul, Finset.sum_add_distrib, Finset.sum_neg_distrib, sub_eq_add_neg, ite_smul, Int.cast_smul_eq_zsmul]

variable [Finite ι] [P.IsReduced]

/-- Actual roots are exactly the integral simple-root combinations on the
certified table. No root indexing or comparison of root counts is required
as an input. -/
theorem root_range_eq_census_image (cert : Certified d)
    (h : ∀ i j, b.cartanMatrix (s i) (s j) = matrix d i j) :
    Set.range P.root = realize b s '' (table d : Set (Vector ℤ d.cartan.size)) := by
  obtain ⟨_, _, hunit, hneg, hclosed, hdecrease⟩ := cert
  ext x
  constructor
  · rintro ⟨a, rfl⟩
    apply b.induction_reflect a
    · rintro k ⟨v, hv, he⟩
      exact ⟨negate v, hneg v hv, by simp [realize_negate, he]⟩
    · intro k hk
      let i := s.symm ⟨k, hk⟩
      exact ⟨unit d i, hunit i, by simp [realize_unit, i]⟩
    · rintro k l ⟨v, hv, he⟩ hl
      let i := s.symm ⟨l, hl⟩
      exact ⟨reflect d v i, hclosed v hv i, by simp [realize_reflect b s h, he, i]⟩
  · rintro ⟨v, hv, rfl⟩
    induction hn : height v using Nat.strong_induction_on generalizing v with
    | h n ih =>
      rcases hdecrease v hv with ⟨i, hi | hi⟩ | ⟨i, hi⟩
      · subst v
        exact ⟨s i, (realize_unit b s i).symm⟩
      · subst v
        exact ⟨P.reflectionPerm (s i) (s i), by simp [realize_negate, realize_unit]⟩
      · obtain ⟨k, hk⟩ := ih _ (hi.trans_eq hn) _ (hclosed v hv i) rfl
        refine ⟨P.reflectionPerm (s i) k, ?_⟩
        rw [P.root_reflectionPerm, hk, realize_reflect b s h, P.reflection_same]

variable [P.IsRootSystem]

omit [P.IsCrystallographic] [Finite ι] [P.IsReduced] in
/-- Uniqueness of the integer coordinates of every table entry. -/
theorem realize_injective : Function.Injective (realize b s) := by
  classical
  let B := b.toWeightBasis.reindex s.symm
  have hb (i : Index d) : B i = P.root (s i) := by simp [B]
  have hv (v : Vector ℤ d.cartan.size) :
      realize b s v = B.equivFun.symm (fun i => (v[i] : K)) := by
    simp [Module.Basis.equivFun_symm_apply, hb, realize, Int.cast_smul_eq_zsmul]
  intro x y h
  rw [hv, hv, B.equivFun.symm.injective.eq_iff] at h
  exact Vector.ext fun i hi => Int.cast_injective (congrFun h ⟨i, hi⟩)

/-- The actual root indices and the census entries correspond bijectively,
and each entry maps to its integral combination of the actual simple roots. -/
theorem exists_census_root_equiv (cert : Certified d)
    (h : ∀ i j, b.cartanMatrix (s i) (s j) = matrix d i j) :
    ∃ e : ↥(table d) ≃ ι, ∀ v, P.root (e v) = realize b s v.val := by
  classical
  have hr := root_range_eq_census_image b s cert h
  have hw (v : ↥(table d)) : ∃ i, P.root i = realize b s v.val := by
    change realize b s v.val ∈ Set.range P.root
    rw [hr]
    exact ⟨v.val, v.property, rfl⟩
  choose f hf using hw
  refine ⟨Equiv.ofBijective f ⟨?_, ?_⟩, hf⟩
  · intro v w he
    exact Subtype.ext (realize_injective b s ((hf v).symm.trans ((congrArg P.root he).trans (hf w))))
  · intro i
    have hi : P.root i ∈ Set.range P.root := ⟨i, rfl⟩
    rw [hr] at hi
    obtain ⟨v, hv, he⟩ := hi
    exact ⟨⟨v, hv⟩, P.root.injective ((hf _).trans he)⟩

end RootSystem

end CubicAnomaly.Classification.RootClassificationExceptional
