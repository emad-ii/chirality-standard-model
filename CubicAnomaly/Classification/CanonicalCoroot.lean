import CubicAnomaly.Classification.CorootComponents
import CubicAnomaly.Classification.AllRankComplex

/-!
# Actual coroot tests for the canonical anomaly

The original Hermitian anomaly has nonzero full radical exactly when an actual
coroot of the complexified isotropy algebra passes the finite mixed weight
test.  The whole complex radical is generated by those coroots.  The final
theorem constructs the Cartan and coroot from the original compact-pair
hypotheses in every rank.
-/

namespace CubicAnomaly.Classification.CanonicalCoroot

open Matrix LieAlgebra LieModule Module
open LieAlgebra.IsKilling
open scoped TensorProduct
open CubicAnomaly.Classification.Structural
open CubicAnomaly.Classification.HermitianRealization
open CubicAnomaly.Classification.Complexification
open CubicAnomaly.Classification.CubicRadical
open CubicAnomaly.Classification.CartanCubic
open CubicAnomaly.Classification.CartanTrace
open CubicAnomaly.Classification.CartanCoroot
open CubicAnomaly.Classification.AnomalyComplexification
open CubicAnomaly.Classification.CanonicalAnomaly

variable {g : Type*} [LieRing g] [LieAlgebra ℝ g] [Module.Finite ℝ g]

section Killing

variable (B : CompactForm g) (h : LieSubalgebra ℝ g)
  (e : lieCommutant (L := h) (M := orthogonalComplement B h) ≃ₐ[ℝ] ℂ)
  [LieAlgebra.IsKilling ℂ (ℂ ⊗[ℝ] h)]
  (H : LieSubalgebra ℂ (ℂ ⊗[ℝ] h)) [H.IsCartanSubalgebra]

/-- Contract the actual positive-half weight cubic with one isotropy coroot
and two Cartan basis vectors.  Weights and multiplicities are intrinsic. -/
noncomputable def canonicalCorootCubic {ι : Type*} (b : Basis ι ℂ H)
    (α : H.root) (i j : ι) : ℂ :=
  let V := invariantEigenspace (complexifiedEnd (commutantComplexStructure e)) Complex.I
  ∑ χ : Weight ℂ H V,
    Module.finrank ℂ (genWeightSpace V χ) •
      (χ (coroot α.val) * χ (b i) * χ (b j))

/-- The actual weight contraction agrees with the full representation's trace
cubic, with the original Hermitian realization and scalar convention. -/
theorem canonical_coroot_cubic_eq_trace {ι : Type*} (b : Basis ι ℂ H)
    (α : H.root) (i j : ι) :
    canonicalCorootCubic B h e H b α i j =
      complexTraceCubicForm
        (complexHermitianRepresentation (hermitianHalfOfCommutant B h e)).toLinearMap
        (coroot α.val) (b i) (b j) :=
  (canonical_cubic_cartan_weight_sum B h e H (coroot α.val) (b i) (b j)).symm

/-- Nonvanishing of the original full Hermitian radical is equivalent to a
finite search over actual coroots, with both remaining slots tested on a basis. -/
theorem canonical_anomaly_iff_null_coroot {ι : Type*} (b : Basis ι ℂ H) :
    (hermitianHalfOfCommutant B h e).cubicRadical ≠ ⊥ ↔
      ∃ α : H.root, ∀ i j, canonicalCorootCubic B h e H b α i j = 0 := by
  rw [← hermitian_complex_radical_ne_bot_iff]
  change CubicRadical.radical _ _ ≠ ⊥ ↔ _
  rw [radical_ne_bot_iff_coroot_basis H b _
    (complex_trace_cubic_invariant _) (complex_trace_cubic_symmetric _)]
  simp only [canonical_coroot_cubic_eq_trace]

/-- The complete complex anomaly radical is the Lie ideal generated by the
actual coroots passing the finite mixed weight test. -/
theorem canonical_complex_radical_eq_lieSpan_null_coroots
    {ι : Type*} (b : Basis ι ℂ H) :
    complexTraceRadical
        (complexHermitianRepresentation (hermitianHalfOfCommutant B h e)) =
      LieSubmodule.lieSpan ℂ (ℂ ⊗[ℝ] h)
        {x : ℂ ⊗[ℝ] h | ∃ α : H.root,
          (∀ i j, canonicalCorootCubic B h e H b α i j = 0) ∧ x = coroot α.val} := by
  change CubicRadical.radical _ _ = _
  rw [radical_eq_lieSpan_null_coroots H b _
    (complex_trace_cubic_invariant _) (complex_trace_cubic_symmetric _)]
  simp only [canonical_coroot_cubic_eq_trace]

/-- The actual complex radical is the sum of the actual simple coroot ideals
selected by the finite mixed weight test.  Simplicity of each summand is
proved in `CorootComponents.corootIdeal_isSimple`, rather than assumed from
a component label. -/
theorem canonical_complex_radical_eq_iSup_null_corootIdeals
    {ι : Type*} (b : Basis ι ℂ H) :
    complexTraceRadical
        (complexHermitianRepresentation (hermitianHalfOfCommutant B h e)) =
      ⨆ α : H.root,
        ⨆ (_ : ∀ i j, canonicalCorootCubic B h e H b α i j = 0),
          CorootComponents.corootIdeal H α := by
  change CubicRadical.radical _ _ = _
  rw [CorootComponents.radical_eq_iSup_null_corootIdeals H b _
    (complex_trace_cubic_invariant _) (complex_trace_cubic_symmetric _)]
  simp only [canonical_coroot_cubic_eq_trace]

/-- Nullness is constant on each actual connected root component. -/
theorem canonical_coroot_null_iff_of_connected {ι : Type*} (b : Basis ι ℂ H)
    {α β : H.root} (hab : CorootConnected H α β) :
    (∀ i j, canonicalCorootCubic B h e H b α i j = 0) ↔
      (∀ i j, canonicalCorootCubic B h e H b β i j = 0) := by
  simp only [canonical_coroot_cubic_eq_trace]
  exact coroot_cubic_zero_iff_of_connected H b _
    (complex_trace_cubic_invariant _) (complex_trace_cubic_symmetric _) hab

end Killing

/-- From the original compact-pair hypotheses, construct a Cartan of the
actual complexified isotropy algebra and a nonzero coroot whose complete
mixed weight contractions vanish.  There is no rank, root-type, or
census-membership assumption. -/
theorem all_rank_exists_null_coroot
    (B : CompactForm g) (h : LieSubalgebra ℝ g)
    (heff : Effective h) (hproper : h ≠ ⊤)
    (e : lieCommutant (L := h) (M := orthogonalComplement B h) ≃ₐ[ℝ] ℂ)
    (hradical : (hermitianHalfOfCommutant B h e).cubicRadical ≠ ⊥) :
    ∃ hK : LieAlgebra.IsKilling ℂ (ℂ ⊗[ℝ] h),
      letI := hK
      ∃ (H : LieSubalgebra ℂ (ℂ ⊗[ℝ] h)) (hH : H.IsCartanSubalgebra),
        letI := hH
        ∃ α : H.root, (coroot α.val : ℂ ⊗[ℝ] h) ≠ 0 ∧
          ∀ i j, canonicalCorootCubic B h e H (Module.finBasis ℂ H) α i j = 0 := by
  letI : LieAlgebra.IsSemisimple ℝ h :=
    (all_rank_structural_reduction_of_commutant B h heff hproper e hradical).2.2.2.1
  let hK := compact_complexification_isKilling (B.restrict h) (LieAlgebra.center_eq_bot ℝ h)
  letI := hK
  obtain ⟨x, hx⟩ := LieAlgebra.exists_isCartanSubalgebra_engel ℂ (ℂ ⊗[ℝ] h)
  let H := LieSubalgebra.engel ℂ x
  letI : H.IsCartanSubalgebra := hx
  obtain ⟨α, hα⟩ :=
    (canonical_anomaly_iff_null_coroot B h e H (Module.finBasis ℂ H)).mp hradical
  exact ⟨hK, H, hx, α, actual_coroot_ne_zero H α, hα⟩

end CubicAnomaly.Classification.CanonicalCoroot
