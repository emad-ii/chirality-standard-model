import CubicAnomaly.Classification.ClassicalConstituentHighest
import CubicAnomaly.Fixed.MatterSpectrum

/-!
# Comparison of irreducible modules by their highest weights

For two irreducible modules with highest vectors at the same weight, take
the cyclic submodule generated by their ordered pair. Projection onto each
factor is surjective. A nonzero kernel would contain the other factor,
producing a second highest line at the generating weight. Both projections
are therefore isomorphisms, and their composite carries the chosen vectors
to one another.
-/

namespace CubicAnomaly.Classification.ClassicalConstituentComparison

open LieAlgebra LieModule LieAlgebra.IsKilling
open CubicAnomaly.Classification.ClassicalConstituentHighest

variable {L M N : Type*} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
  [LieAlgebra.IsKilling ℂ L] (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
  {b : (rootSystem H).Base} {μ : H → ℂ}
  [AddCommGroup M] [Module ℂ M] [LieRingModule L M] [LieModule ℂ L M]
  [AddCommGroup N] [Module ℂ N] [LieRingModule L N] [LieModule ℂ L N]

private def leftProjection : (M × N) →ₗ⁅ℂ,L⁆ M := {
  LinearMap.fst ℂ M N with map_lie' := by intros; rfl }

private def rightProjection : (M × N) →ₗ⁅ℂ,L⁆ N := {
  LinearMap.snd ℂ M N with map_lie' := by intros; rfl }

private def leftInsertion : M →ₗ⁅ℂ,L⁆ (M × N) := {
  LinearMap.inl ℂ M N with map_lie' := by intro x y; exact Prod.ext rfl (lie_zero x).symm }

private def rightInsertion : N →ₗ⁅ℂ,L⁆ (M × N) := {
  LinearMap.inr ℂ M N with map_lie' := by intro x y; exact Prod.ext (lie_zero x).symm rfl }

omit [LieModule ℂ L M] [LieModule ℂ L N] in
private theorem product_highest {v : M} {w : N}
    (hv : v ≠ 0 ∨ w ≠ 0)
    (hv' : ∀ x : H, ⁅x, v⁆ = μ x • v) (hw' : ∀ x : H, ⁅x, w⁆ = μ x • w)
    (hv'' : ∀ α : H.root, b.IsPos α → ∀ x ∈ rootSpace H α.val, ⁅x, v⁆ = 0)
    (hw'' : ∀ α : H.root, b.IsPos α → ∀ x ∈ rootSpace H α.val, ⁅x, w⁆ = 0) :
    IsHighestVector H b μ (v, w) := by
  exact ⟨fun h => hv.elim (fun hn => hn (congrArg Prod.fst h)) (fun hn => hn (congrArg Prod.snd h)),
    fun x => Prod.ext (hv' x) (hw' x),
    fun α hα x hx => Prod.ext (hv'' α hα x hx) (hw'' α hα x hx)⟩

private noncomputable def equivOfBijective {S V : Type*} [AddCommGroup S] [Module ℂ S]
    [LieRingModule L S] [LieModule ℂ L S] [AddCommGroup V] [Module ℂ V]
    [LieRingModule L V] [LieModule ℂ L V] (p : S →ₗ⁅ℂ,L⁆ V) (hp : Function.Bijective p) :
    S ≃ₗ⁅ℂ,L⁆ V := { LinearEquiv.ofBijective p.toLinearMap hp with
      toFun := p
      map_lie' := by intros; apply p.map_lie }

/-- Two irreducible modules with the same actual highest weight are
equivariantly isomorphic by an isomorphism matching any chosen pair
of nonzero highest vectors. -/
theorem irreducible_equiv_of_highest_weight [IsIrreducible ℂ L M] [IsIrreducible ℂ L N]
    {v : M} {w : N} (hv : IsHighestVector H b μ v) (hw : IsHighestVector H b μ w) :
    ∃ E : M ≃ₗ⁅ℂ,L⁆ N, E v = w := by
  let T := LieSubmodule.lieSpan ℂ L {(v, w)}
  have ht : (v, w) ∈ T := LieSubmodule.subset_lieSpan (Set.mem_singleton _)
  have hpair := product_highest H (Or.inl hv.1) hv.2.1 hw.2.1 hv.2.2 hw.2.2
  let p : T →ₗ⁅ℂ,L⁆ M := leftProjection.comp T.incl
  let q : T →ₗ⁅ℂ,L⁆ N := rightProjection.comp T.incl
  have hp : Function.Surjective p := by
    apply (LieModuleHom.range_eq_top _).mp
    rcases IsSimpleOrder.eq_bot_or_eq_top p.range with hb | htop
    · have hz : v ∈ p.range := ⟨⟨_, ht⟩, rfl⟩
      exact (hv.1 (by simpa [hb] using hz)).elim
    · exact htop
  have hq : Function.Surjective q := by
    apply (LieModuleHom.range_eq_top _).mp
    rcases IsSimpleOrder.eq_bot_or_eq_top q.range with hb | htop
    · have hz : w ∈ q.range := ⟨⟨_, ht⟩, rfl⟩
      exact (hw.1 (by simpa [hb] using hz)).elim
    · exact htop
  have hL : T.comap leftInsertion = ⊥ := by
    apply (IsSimpleOrder.eq_bot_or_eq_top _).resolve_right
    intro heq
    have hz : (v, (0 : N)) ∈ T := show v ∈ T.comap leftInsertion from heq ▸ LieSubmodule.mem_top _
    have hl := product_highest (w := (0 : N)) H (Or.inl hv.1) hv.2.1 (fun _ => by simp)
      hv.2.2 (fun _ _ _ _ => by simp)
    obtain ⟨c, hcv⟩ := Submodule.mem_span_singleton.mp (cyclic_highest_line H b hpair hl hz)
    have hc : c • w = 0 := congrArg Prod.snd hcv
    have hc' := (smul_eq_zero.mp hc).resolve_right hw.1
    exact hv.1 (by simpa [hc'] using (congrArg Prod.fst hcv).symm)
  have hR : T.comap rightInsertion = ⊥ := by
    apply (IsSimpleOrder.eq_bot_or_eq_top _).resolve_right
    intro heq
    have hz : ((0 : M), w) ∈ T := show w ∈ T.comap rightInsertion from heq ▸ LieSubmodule.mem_top _
    have hr := product_highest (v := (0 : M)) H (Or.inr hw.1) (fun _ => by simp) hw.2.1
      (fun _ _ _ _ => by simp) hw.2.2
    obtain ⟨c, hcw⟩ := Submodule.mem_span_singleton.mp (cyclic_highest_line H b hpair hr hz)
    have hc : c • v = 0 := congrArg Prod.fst hcw
    have hc' := (smul_eq_zero.mp hc).resolve_right hv.1
    exact hw.1 (by simpa [hc'] using (congrArg Prod.snd hcw).symm)
  have hp' : Function.Injective p := by
    apply (injective_iff_map_eq_zero _).mpr
    rintro ⟨⟨a, d⟩, hd⟩ ha
    change a = 0 at ha
    subst a
    have hd' : d ∈ T.comap rightInsertion := hd
    have hzero : d = 0 := by simpa [hR] using hd'
    exact Subtype.ext (Prod.ext rfl hzero)
  have hq' : Function.Injective q := by
    apply (injective_iff_map_eq_zero _).mpr
    rintro ⟨⟨a, d⟩, hd⟩ hz
    change d = 0 at hz
    subst d
    have ha' : a ∈ T.comap leftInsertion := hd
    have hzero : a = 0 := by simpa [hL] using ha'
    exact Subtype.ext (Prod.ext hzero rfl)
  let E := equivOfBijective p ⟨hp', hp⟩
  let F := equivOfBijective q ⟨hq', hq⟩
  exact ⟨E.symm.trans F, by
    change F (E.symm (E (⟨(v, w), ht⟩ : T))) = w
    rw [LieModuleEquiv.symm_apply_apply]
    rfl⟩

end CubicAnomaly.Classification.ClassicalConstituentComparison
