import CubicAnomaly.Classification.CartanCoroot

/-!
# Simple ideals generated by actual coroots

Each actual coroot generates a simple ideal.  Every ideal, including a full
cubic radical, is the sum of the coroot ideals it contains.  Thus the coroot
test identifies actual simple Lie ideals without assuming a factor
decomposition or attaching type labels to computed root components.
-/

namespace CubicAnomaly.Classification.CorootComponents

open LieAlgebra LieModule Module
open LieAlgebra.IsKilling
open CubicAnomaly.Classification.CubicRadical
open CubicAnomaly.Classification.CartanCubic
open CubicAnomaly.Classification.CartanCoroot

variable {K L : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
  [FiniteDimensional K L] [LieAlgebra.IsKilling K L]
  (H : LieSubalgebra K L) [H.IsCartanSubalgebra] [IsTriangularizable K H L]

omit [CharZero K] [IsTriangularizable K H L] in
private theorem cartan_ideal_parts (I : LieIdeal K L) (t : H) :
    ∃ x y : H, (x : L) ∈ I ∧ (y : L) ∈ Iᶜ ∧ x + y = t := by
  have ht : (t : L) ∈ I ⊔ Iᶜ := by rw [sup_compl_eq_top]; trivial
  obtain ⟨x, hx, y, hy, hxy⟩ := (LieSubmodule.mem_sup I Iᶜ t).mp ht
  have hbr (s : H) : ⁅(s : L), x⁆ = 0 := by
    have heq : ⁅(s : L), x⁆ + ⁅(s : L), y⁆ = 0 := by
      rw [← lie_add, hxy]
      change (⁅s, t⁆ : H).val = 0
      rw [trivial_lie_zero]
      rfl
    have hmem : ⁅(s : L), x⁆ ∈ I ⊓ Iᶜ :=
      ⟨I.lie_mem hx, by
        rw [eq_neg_of_add_eq_zero_left heq]
        exact Iᶜ.neg_mem (Iᶜ.lie_mem hy)⟩
    simpa only [inf_compl_eq_bot, LieSubmodule.mem_bot] using hmem
  have hxH : x ∈ H := by
    have hr : x ∈ rootSpace H (0 : H → K) :=
      (mem_genWeightSpace L 0 x).mpr fun s => ⟨1, by simp [hbr s]⟩
    simpa only [rootSpace_zero_eq, LieSubalgebra.mem_toLieSubmodule] using hr
  have hyH : y ∈ H := by
    have heq : y = (t : L) - x := by rw [← hxy]; abel
    rw [heq]
    exact H.sub_mem t.property hxH
  exact ⟨⟨x, hxH⟩, ⟨y, hyH⟩, hx, hy, Subtype.ext hxy⟩

/-- A coroot lies wholly in an ideal or its complementary ideal. -/
theorem coroot_mem_ideal_or_compl (I : LieIdeal K L) (α : H.root) :
    (coroot α.val : L) ∈ I ∨ (coroot α.val : L) ∈ Iᶜ := by
  obtain ⟨x, y, hx, hy, hxy⟩ := cartan_ideal_parts H I (coroot α.val)
  by_cases hαx : α.val x = 0
  · right
    apply coroot_mem_ideal_of_cartan_eval_ne_zero H Iᶜ α y hy
    have hsum : α.val x + α.val y = 2 := by
      rw [← map_add, hxy]
      exact root_apply_coroot (Finset.mem_filter.mp α.property).2
    rw [hαx, zero_add] at hsum
    rw [hsum]
    norm_num
  · exact Or.inl (coroot_mem_ideal_of_cartan_eval_ne_zero H I α x hx hαx)

/-- The actual Lie ideal generated by a single actual coroot. -/
def corootIdeal (α : H.root) : LieIdeal K L :=
  LieSubmodule.lieSpan K L {(coroot α.val : L)}

/-- A coroot ideal is an atom in the lattice of actual Lie ideals. -/
theorem corootIdeal_isAtom (α : H.root) : IsAtom (corootIdeal H α) := by
  have hmem : (coroot α.val : L) ∈ corootIdeal H α :=
    LieSubmodule.subset_lieSpan (Set.mem_singleton _)
  have hne : corootIdeal H α ≠ ⊥ := by
    intro hbot
    exact actual_coroot_ne_zero H α (by simpa only [hbot, LieSubmodule.mem_bot] using hmem)
  apply isAtom_iff_le_of_ge.mpr
  refine ⟨hne, ?_⟩
  intro I hI hle
  rcases coroot_mem_ideal_or_compl H I α with hin | hout
  · exact LieSubmodule.lieSpan_le.mpr (by simpa using hin)
  · have hcomp : corootIdeal H α ≤ Iᶜ :=
      LieSubmodule.lieSpan_le.mpr (by simpa using hout)
    have hbot : I = ⊥ := by
      apply le_antisymm _ bot_le
      calc I ≤ I ⊓ Iᶜ := le_inf le_rfl (hle.trans hcomp)
           _ = ⊥ := inf_compl_eq_bot
    exact False.elim (hI hbot)

/-- Each coroot ideal is simple as a Lie algebra, without a type classification. -/
theorem corootIdeal_isSimple (α : H.root) : LieAlgebra.IsSimple K (corootIdeal H α) :=
  LieAlgebra.IsSemisimple.isSimple_of_isAtom _ (corootIdeal_isAtom H α)

/-- Connected actual roots generate the same simple ideal. -/
theorem corootIdeal_eq_of_connected {α β : H.root} (hab : CorootConnected H α β) :
    corootIdeal H α = corootIdeal H β := by
  apply le_antisymm
  · apply LieSubmodule.lieSpan_le.mpr
    have hb : (coroot β.val : L) ∈ corootIdeal H β :=
      LieSubmodule.subset_lieSpan (Set.mem_singleton _)
    simpa using (coroot_mem_ideal_iff_of_connected H (corootIdeal H β) hab).mpr hb
  · apply LieSubmodule.lieSpan_le.mpr
    have ha : (coroot α.val : L) ∈ corootIdeal H α :=
      LieSubmodule.subset_lieSpan (Set.mem_singleton _)
    simpa using (coroot_mem_ideal_iff_of_connected H (corootIdeal H α) hab).mp ha

variable [IsAlgClosed K]

/-- Every ideal is a sum of the actual simple coroot ideals that it contains. -/
theorem ideal_eq_iSup_corootIdeals (I : LieIdeal K L) :
    I = ⨆ α : H.root, ⨆ (_ : (coroot α.val : L) ∈ I), corootIdeal H α := by
  apply le_antisymm
  · apply (ideal_le_iff_coroot H I _).mpr
    intro α hα
    have hle : corootIdeal H α ≤
        ⨆ β : H.root, ⨆ (_ : (coroot β.val : L) ∈ I), corootIdeal H β :=
      le_iSup_of_le α (le_iSup_of_le hα le_rfl)
    exact hle (LieSubmodule.subset_lieSpan (Set.mem_singleton _))
  · refine iSup_le fun α => iSup_le fun hα => ?_
    exact LieSubmodule.lieSpan_le.mpr (by simpa using hα)

/-- The full radical is exactly the sum of the actual simple ideals selected
by the finite mixed coroot test. -/
theorem radical_eq_iSup_null_corootIdeals {ι : Type*} (b : Basis ι K H)
    (c : TrilinearForm (R := K) (L := L) (S := K))
    (hc : IsInvariant c) (hs : IsSymmetric c) :
    CubicRadical.radical c hc = ⨆ α : H.root,
      ⨆ (_ : ∀ i j, c (coroot α.val) (b i) (b j) = 0), corootIdeal H α := by
  rw [ideal_eq_iSup_corootIdeals H (CubicRadical.radical c hc)]
  congr 1
  funext α
  rw [cartan_mem_radical_iff_basis H b c hc hs (coroot α.val)]

end CubicAnomaly.Classification.CorootComponents
