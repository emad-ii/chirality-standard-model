import CubicAnomaly.Classification.ClassicalConstituents
import CubicAnomaly.Classification.TensorInvariantForms
import Mathlib.Algebra.Lie.Ideal
import Mathlib.Data.Nat.Choose.Sum

/-!
# Nonvanishing of a squared matrix coefficient

For any nonzero vector in an irreducible module over a characteristic-zero
field, the submodule generated by its tensor square detects the square of
every nonzero linear functional. The proof iterates the binomial formula
for the diagonal Lie action. At the first nonvanishing order, the doubled
order leaves only the middle binomial term.
-/

namespace CubicAnomaly.Classification.ClassicalConstituentSquare

open LieModule Module
open scoped TensorProduct

variable {K L M : Type*} [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]
    [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]

/-- The product of two linear functionals as a functional on the tensor square. -/
def tensorFunctional (f g : Dual K M) : Dual K (M ⊗[K] M) :=
  (TensorProduct.lid K K).toLinearMap.comp (TensorProduct.map f g)

omit [CharZero K] in
@[simp] private theorem tensorFunctional_tmul (f g : Dual K M) (u v : M) :
    tensorFunctional f g (u ⊗ₜ[K] v) = f u * g v := rfl

omit [CharZero K] in
private theorem tensorFunctional_map (f g : Dual K M) (A B : End K M) (z : M ⊗[K] M) :
    tensorFunctional f g (TensorProduct.map A B z) = tensorFunctional (f.comp A) (g.comp B) z := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul u v => rfl
  | add z w hz hw => simp only [map_add, hz, hw]

omit [CharZero K] in
private theorem diagonal_power (x : L) (n : ℕ) (z : M ⊗[K] M) (f g : Dual K M) :
    let A := toEnd K L M x
    tensorFunctional f g ((toEnd K L (M ⊗[K] M) x ^ n) z) =
      ∑ i ∈ Finset.antidiagonal n, n.choose i.1 •
        tensorFunctional (f.comp (A ^ i.1)) (g.comp (A ^ i.2)) z := by
  intro A
  have heq : toEnd K L (M ⊗[K] M) x = A.rTensor M + A.lTensor M := rfl
  have hc : Commute (A.rTensor M) (A.lTensor M) := by
    change (A.rTensor M).comp (A.lTensor M) = (A.lTensor M).comp (A.rTensor M)
    rw [LinearMap.rTensor_comp_lTensor, LinearMap.lTensor_comp_rTensor]
  rw [heq, hc.add_pow']
  simp only [LinearMap.sum_apply, LinearMap.smul_apply, map_sum, map_nsmul,
    LinearMap.rTensor_pow, LinearMap.lTensor_pow]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  change tensorFunctional f g (((A ^ i.1).rTensor M).comp ((A ^ i.2).lTensor M) z) = _
  rw [LinearMap.rTensor_comp_lTensor, tensorFunctional_map]

private def extend (A : End K M) (S : Submodule K M) : Submodule K M :=
  ⨆ n : ℕ, S.map (A ^ n)

private def Detected (T : LieSubmodule K L (M ⊗[K] M)) (S : Submodule K M) : Prop :=
  ∀ f : Dual K M, (∃ u ∈ S, f u ≠ 0) →
    ∃ z ∈ T, tensorFunctional f f z ≠ 0 ∧
      ∀ g h : Dual K M, (S ≤ LinearMap.ker g ∨ S ≤ LinearMap.ker h) →
        tensorFunctional g h z = 0

private theorem detect_extend (T : LieSubmodule K L (M ⊗[K] M)) (S : Submodule K M)
    (hs : Detected T S) (x : L) : Detected T (extend (toEnd K L M x) S) := by
  classical
  let A := toEnd K L M x
  intro f hf
  let good := fun n : ℕ => ∃ u ∈ S, f ((A ^ n) u) ≠ 0
  have hex : ∃ n, good n := by
    by_contra! hn
    obtain ⟨u, hu, hne⟩ := hf
    apply hne
    suffices extend A S ≤ LinearMap.ker f from this hu
    apply iSup_le
    rintro n _ ⟨s, hmem, rfl⟩
    by_contra h'
    exact hn n ⟨s, hmem, h'⟩
  let n := Nat.find hex
  obtain ⟨z, hz, hne, hsup⟩ := hs (f.comp (A ^ n)) (Nat.find_spec hex)
  let w := (toEnd K L (M ⊗[K] M) x ^ (n + n)) z
  have hw : w ∈ T := by
    suffices ∀ k : ℕ, (toEnd K L (M ⊗[K] M) x ^ k) z ∈ T from this _
    intro k
    induction k with
    | zero => simpa using hz
    | succ k ih => rw [pow_succ']; exact T.lie_mem ih
  refine ⟨w, hw, ?_, ?_⟩
  · dsimp only [w]
    rw [diagonal_power, Finset.sum_eq_single (n, n)]
    · rw [nsmul_eq_mul]
      exact mul_ne_zero (Nat.cast_ne_zero.mpr (Nat.choose_pos (by omega)).ne') hne
    · rintro ⟨i,j⟩ hij hneq
      have hsum := Finset.mem_antidiagonal.mp hij
      have hsmall : i < n ∨ j < n := by
        by_contra! hg
        exact hneq (Prod.ext (by omega) (by omega))
      suffices tensorFunctional (f.comp (A ^ i)) (f.comp (A ^ j)) z = 0 by simp [this, A]
      apply hsup
      have step (k : ℕ) (hk : k < n) : S ≤ LinearMap.ker (f.comp (A ^ k)) := by
        intro u hu
        by_contra h'
        exact Nat.find_min hex hk ⟨u, hu, h'⟩
      exact hsmall.imp (step i) (step j)
    · simp
  · intro g h hkill
    dsimp only [w]
    rw [diagonal_power]
    apply Finset.sum_eq_zero
    intro i _
    have step (p : Dual K M) (hp : extend A S ≤ LinearMap.ker p) (k : ℕ) :
        S ≤ LinearMap.ker (p.comp (A ^ k)) := by
      intro u hu
      exact hp ((le_iSup (fun j : ℕ => S.map (A ^ j)) k) ⟨u, hu, rfl⟩)
    have hzero := hsup (g.comp (A ^ i.1)) (h.comp (A ^ i.2))
      (hkill.imp (fun hg => step g hg _) (fun hh => step h hh _))
    simp [hzero, A]

private def stage (v : M) : List L → Submodule K M
  | [] => K ∙ v
  | x :: xs => extend (toEnd K L M x) (stage v xs)

private def allStages (v : M) : LieSubmodule K L M where
  toSubmodule := ⨆ xs : List L, stage v xs
  lie_mem := by
    intro x u hu
    let S := ⨆ xs : List L, stage (K := K) v xs
    suffices h : S ≤ S.comap (toEnd K L M x) from h hu
    apply iSup_le
    intro xs w hw
    apply le_iSup (stage v) (x :: xs)
    apply le_iSup (fun j : ℕ => (stage v xs).map (toEnd K L M x ^ j)) 1
    exact ⟨w, hw, by rw [pow_one]⟩

private theorem detect_stage (v : M) (T : LieSubmodule K L (M ⊗[K] M))
    (ht : v ⊗ₜ[K] v ∈ T) (xs : List L) : Detected T (stage v xs) := by
  induction xs with
  | nil =>
    intro f hf
    have hfv : f v ≠ 0 := by
      intro hz
      obtain ⟨u, hu, hne⟩ := hf
      exact hne (((Submodule.span_singleton_le_iff_mem v (LinearMap.ker f)).mpr hz) hu)
    refine ⟨_, ht, mul_ne_zero hfv hfv, ?_⟩
    intro g h hg
    have hv : v ∈ stage (K := K) v ([] : List L) := Submodule.mem_span_singleton_self v
    rcases hg with hg | hh
    · rw [tensorFunctional_tmul, show g v = 0 from hg hv, zero_mul]
    · rw [tensorFunctional_tmul, show h v = 0 from hh hv, mul_zero]
  | cons x xs ih => exact detect_extend T _ ih x

/-- For an irreducible Lie module in characteristic zero, every nonzero
functional has a nonzero tensor square on the cyclic submodule generated
by any nonzero pure square. -/
theorem irreducible_tensor_square_detects [IsIrreducible K L M] (v : M) (hv : v ≠ 0)
    (f : Dual K M) (hf : f ≠ 0) :
    ∃ z ∈ LieSubmodule.lieSpan K L {v ⊗ₜ[K] v}, tensorFunctional f f z ≠ 0 := by
  classical
  let T := LieSubmodule.lieSpan K L {v ⊗ₜ[K] v}
  have hT : v ⊗ₜ[K] v ∈ T := LieSubmodule.subset_lieSpan (Set.mem_singleton _)
  have htop : allStages (L := L) (K := K) v = ⊤ := by
    apply (IsSimpleOrder.eq_bot_or_eq_top _).resolve_left
    intro hbot
    have hmem : v ∈ allStages (L := L) (K := K) v :=
      (le_iSup (stage v) ([] : List L)) (Submodule.mem_span_singleton_self v)
    exact hv (by simpa [hbot] using hmem)
  have hex : ∃ (xs : List L) (u : M), u ∈ stage (K := K) v xs ∧ f u ≠ 0 := by
    by_contra! hn
    apply hf
    ext u
    have hle : (allStages (L := L) (K := K) v).toSubmodule ≤ LinearMap.ker f := by
      exact iSup_le (fun xs u hu => hn xs u hu)
    exact hle (show u ∈ allStages (L := L) (K := K) v from htop ▸ LieSubmodule.mem_top _)
  obtain ⟨xs, u, hu, hne⟩ := hex
  obtain ⟨z, hz, hdet, _⟩ := detect_stage v T hT xs f ⟨u, hu, hne⟩
  exact ⟨z, hz, hdet⟩

/-- An irreducible constituent containing a pure square in a self-dual
irreducible defining module carries a nondegenerate invariant form. -/
theorem constituent_of_pure_square_self_dual [IsIrreducible K L M] {S : Type*}
    [AddCommGroup S] [Module K S] [LieRingModule L S] [LieModule K L S]
    [IsIrreducible K L S] [FiniteDimensional K S] (β : LinearMap.BilinForm K M)
    (hβ : β.Nondegenerate) (hInv : β.lieInvariant L)
    (F : S →ₗ⁅K,L⁆ (M ⊗[K] M)) (v : M) (hv : v ≠ 0) (hF : v ⊗ₜ[K] v ∈ F.range) :
    Nonempty (S ≃ₗ⁅K,L⁆ Dual K S) := by
  let Φ := β.tmul β
  have hΦ := TensorInvariantForms.tensor_bilin_form_invariant β hInv β hInv
  let φ := Φ.compl₁₂ F.toLinearMap F.toLinearMap
  let G : S →ₗ⁅K,L⁆ Dual K S := { φ with
    map_lie' := by
      intro x a
      ext b
      change Φ (F ⁅x, a⁆) (F b) = -Φ (F a) (F ⁅x,b⁆)
      rw [F.map_lie, F.map_lie]
      exact hΦ x _ _ }
  obtain ⟨s, hs⟩ := hF
  have hne : β v ≠ 0 := fun hz => hv (hβ.1 v fun y => LinearMap.congr_fun hz y)
  obtain ⟨z, hz, hz'⟩ := irreducible_tensor_square_detects (L := L) v hv (β v) hne
  have hrange : LieSubmodule.lieSpan K L {v ⊗ₜ[K] v} ≤ F.range :=
    LieSubmodule.lieSpan_le.mpr (Set.singleton_subset_iff.mpr ⟨s, hs⟩)
  obtain ⟨t, ht⟩ := hrange hz
  have hpair : Φ (v ⊗ₜ[K] v) = tensorFunctional (β v) (β v) := by
    ext a b
    change (β.tmul β) (v ⊗ₜ[K] v) (a ⊗ₜ[K] b) = _
    simp [LinearMap.BilinForm.tmul, LinearMap.BilinForm.tensorDistrib_tmul, tensorFunctional, mul_comm]
  have hker : G.ker = ⊥ := by
    apply (IsSimpleOrder.eq_bot_or_eq_top _).resolve_right
    intro htop
    have hzero : G s = 0 := show s ∈ G.ker from htop ▸ LieSubmodule.mem_top _
    have hh : Φ (F s) (F t) = 0 := LinearMap.congr_fun hzero t
    exact hz' (by simpa [hs, ht, hpair] using hh)
  have hinj := (LieModuleHom.ker_eq_bot G).mp hker
  exact ⟨{ G.toLinearMap.linearEquivOfInjective hinj Subspace.dual_finrank_eq.symm with
    toFun := G
    map_lie' := by intros; apply G.map_lie }⟩

end CubicAnomaly.Classification.ClassicalConstituentSquare
